{"ch":75,"basmalaPrefixLen":39,"verses":[{"v":1,"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَٰمَةِ"},{"v":2,"t":"وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ"},{"v":3,"t":"أَيَحْسَبُ ٱلْإِنسَٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ"},{"v":4,"t":"بَلَىٰ قَٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ"},{"v":5,"t":"بَلْ يُرِيدُ ٱلْإِنسَٰنُ لِيَفْجُرَ أَمَامَهُۥ"},{"v":6,"t":"يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَٰمَةِ"},{"v":7,"t":"فَإِذَا بَرِقَ ٱلْبَصَرُ"},{"v":8,"t":"وَخَسَفَ ٱلْقَمَرُ"},{"v":9,"t":"وَجُمِعَ ٱلشَّمْسُ وَٱلْقَمَرُ"},{"v":10,"t":"يَقُولُ ٱلْإِنسَٰنُ يَوْمَئِذٍ أَيْنَ ٱلْمَفَرُّ"},{"v":11,"t":"كَلَّا لَا وَزَرَ"},{"v":12,"t":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمُسْتَقَرُّ"},{"v":13,"t":"يُنَبَّؤُا۟ ٱلْإِنسَٰنُ يَوْمَئِذٍۭ بِمَا قَدَّمَ وَأَخَّرَ"},{"v":14,"t":"بَلِ ٱلْإِنسَٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٌ"},{"v":15,"t":"وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ"},{"v":16,"t":"لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ"},{"v":17,"t":"إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ"},{"v":18,"t":"فَإِذَا قَرَأْنَٰهُ فَٱتَّبِعْ قُرْءَانَهُۥ"},{"v":19,"t":"ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥ"},{"v":20,"t":"كَلَّا بَلْ تُحِبُّونَ ٱلْعَاجِلَةَ"},{"v":21,"t":"وَتَذَرُونَ ٱلْـَٔاخِرَةَ"},{"v":22,"t":"وُجُوهٌ يَوْمَئِذٍ نَّاضِرَةٌ"},{"v":23,"t":"إِلَىٰ رَبِّهَا نَاظِرَةٌ"},{"v":24,"t":"وَوُجُوهٌ يَوْمَئِذٍۭ بَاسِرَةٌ"},{"v":25,"t":"تَظُنُّ أَن يُفْعَلَ بِهَا فَاقِرَةٌ"},{"v":26,"t":"كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِىَ"},{"v":27,"t":"وَقِيلَ مَنْ رَاقٍ"},{"v":28,"t":"وَظَنَّ أَنَّهُ ٱلْفِرَاقُ"},{"v":29,"t":"وَٱلْتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ"},{"v":30,"t":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمَسَاقُ"},{"v":31,"t":"فَلَا صَدَّقَ وَلَا صَلَّىٰ"},{"v":32,"t":"وَلَٰكِن كَذَّبَ وَتَوَلَّىٰ"},{"v":33,"t":"ثُمَّ ذَهَبَ إِلَىٰٓ أَهْلِهِۦ يَتَمَطَّىٰٓ"},{"v":34,"t":"أَوْلَىٰ لَكَ فَأَوْلَىٰ"},{"v":35,"t":"ثُمَّ أَوْلَىٰ لَكَ فَأَوْلَىٰٓ"},{"v":36,"t":"أَيَحْسَبُ ٱلْإِنسَٰنُ أَن يُتْرَكَ سُدًى"},{"v":37,"t":"أَلَمْ يَكُ نُطْفَةً مِّن مَّنِىٍّ يُمْنَىٰ"},{"v":38,"t":"ثُمَّ كَانَ عَلَقَةً فَخَلَقَ فَسَوَّىٰ"},{"v":39,"t":"فَجَعَلَ مِنْهُ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ"},{"v":40,"t":"أَلَيْسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰٓ أَن يُحْـِۧىَ ٱلْمَوْتَىٰ"}]}