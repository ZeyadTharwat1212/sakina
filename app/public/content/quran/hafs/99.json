{"ch":99,"verses":[{"v":1,"t":"إِذَا زُلۡزِلَتِ ٱلۡأَرۡضُ زِلۡزَالَهَا","page":599,"l1":8,"l2":8},{"v":2,"t":"وَأَخۡرَجَتِ ٱلۡأَرۡضُ أَثۡقَالَهَا","page":599,"l1":8,"l2":8},{"v":3,"t":"وَقَالَ ٱلۡإِنسَٰنُ مَا لَهَا","page":599,"l1":8,"l2":9},{"v":4,"t":"يَوۡمَئِذٖ تُحَدِّثُ أَخۡبَارَهَا","page":599,"l1":9,"l2":9},{"v":5,"t":"بِأَنَّ رَبَّكَ أَوۡحَىٰ لَهَا","page":599,"l1":9,"l2":9},{"v":6,"t":"يَوۡمَئِذٖ يَصۡدُرُ ٱلنَّاسُ أَشۡتَاتٗا لِّيُرَوۡاْ أَعۡمَٰلَهُمۡ","page":599,"l1":10,"l2":10},{"v":7,"t":"فَمَن يَعۡمَلۡ مِثۡقَالَ ذَرَّةٍ خَيۡرٗا يَرَهُۥ","page":599,"l1":10,"l2":11},{"v":8,"t":"وَمَن يَعۡمَلۡ مِثۡقَالَ ذَرَّةٖ شَرّٗا يَرَهُۥ","page":599,"l1":11,"l2":11}]}