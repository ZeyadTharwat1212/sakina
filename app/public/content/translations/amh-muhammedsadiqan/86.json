{"ch":86,"verses":[{"v":1,"t":"በሰማዩ በሌሊት መጪውም እምላለሁ፡፡"},{"v":2,"t":"የሌሊት መጪውም ምን እንደ ኾነ ምን አሳወቀህ"},{"v":3,"t":"ጨለማን ቀዳጁ ኮከብ ነው፡፡"},{"v":4,"t":"ነፍስ ሁሉ በእርሷ ላይ ጠባቂ ያለባት እንጅ ሌላ አይደለችም፡፡"},{"v":5,"t":"ሰውም ከምን እንደተፈጠረ ይመልከት፡፡"},{"v":6,"t":"ከተስፈንጣሪ ውሃ ተፈጠረ፡፡"},{"v":7,"t":"ከጀርባና ከእርግብግብቶች መካከል የሚወጣ ከኾነ (ውሃ)፡፡"},{"v":8,"t":"እርሱ (አላህ) በመመለሱ ላይ በእርግጥ ቻይ ነው፡፡"},{"v":9,"t":"ምስጢሮች በሚገለጡበት ቀን፡፡"},{"v":10,"t":"ለእርሱም (ለሰው) ኀይልና ረዳት ምንም የለውም፡፡"},{"v":11,"t":"የመመለስ ባለቤት በኾነችው ሰማይም እምላለሁ፡፡"},{"v":12,"t":"(በበቃይ) የመሰንጠቅ ባለቤት በኾነችው ምድርም፤"},{"v":13,"t":"እርሱ (እውነትን ከውሸት) የሚለይ ቃል ነው፡፡"},{"v":14,"t":"እርሱም ቀልድ አይደለም፡፡"},{"v":15,"t":"እነርሱ በእርግጥ ተንኮልን ይሠራሉ፡፡"},{"v":16,"t":"(እኔ) ተንኮልንም እመልሳለሁ፡፡"},{"v":17,"t":"ከሓዲዎችንም ቀን ስጣቸው፡፡ ጥቂትን ጊዜ አቆያቸው፡፡"}]}