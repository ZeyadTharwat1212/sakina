{"ch":96,"verses":[{"v":1,"t":"ٱقۡرَأۡ بِٱسۡمِ رَبِّكَ ٱلَّذِي خَلَقَ","page":597,"l1":11,"l2":11},{"v":2,"t":"خَلَقَ ٱلۡإِنسَٰنَ مِنۡ عَلَقٍ","page":597,"l1":11,"l2":11},{"v":3,"t":"ٱقۡرَأۡ وَرَبُّكَ ٱلۡأَكۡرَمُ","page":597,"l1":11,"l2":12},{"v":4,"t":"ٱلَّذِي عَلَّمَ بِٱلۡقَلَمِ","page":597,"l1":12,"l2":12},{"v":5,"t":"عَلَّمَ ٱلۡإِنسَٰنَ مَا لَمۡ يَعۡلَمۡ","page":597,"l1":12,"l2":13},{"v":6,"t":"كـَلَّآ إِنَّ ٱلۡإِنسَٰنَ لَيَطۡغَىٰٓ","page":597,"l1":13,"l2":13},{"v":7,"t":"أَن رَّءَاهُ ٱسۡتَغۡنَىٰٓ","page":597,"l1":13,"l2":13},{"v":8,"t":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجۡعَىٰٓ","page":597,"l1":14,"l2":14},{"v":9,"t":"أَرَءَيۡتَ ٱلَّذِي يَنۡهَىٰ","page":597,"l1":14,"l2":14},{"v":10,"t":"عَبۡدًا إِذَا صَلَّىٰٓ","page":597,"l1":14,"l2":15},{"v":11,"t":"أَرَءَيۡتَ إِن كَانَ عَلَى ٱلۡهُدَىٰٓ","page":597,"l1":15,"l2":15},{"v":12,"t":"أَوۡ أَمَرَ بِٱلتَّقۡوَىٰٓ","page":597,"l1":15,"l2":15},{"v":13,"t":"أَرَءَيۡتَ إِن كَذَّبَ وَتَوَلَّىٰٓ","page":598,"l1":1,"l2":1},{"v":14,"t":"أَلَمۡ يَعۡلَم بِأَنَّ ٱللَّهَ يَرَىٰ","page":598,"l1":1,"l2":1},{"v":15,"t":"كـَلَّا لَئِن لَّمۡ يَنتَهِ لَنَسۡفَعَۢا بِٱلنَّاصِيَةِ","page":598,"l1":1,"l2":2},{"v":16,"t":"نَاصِيَةٖ كَٰذِبَةٍ خَاطِئَةٖ","page":598,"l1":2,"l2":2},{"v":17,"t":"فَلۡيَدۡعُ نَادِيَهُۥ","page":598,"l1":2,"l2":2},{"v":18,"t":"سَنَدۡعُ ٱلزَّبَانِيَةَ","page":598,"l1":3,"l2":3},{"v":19,"t":"كـَلَّا لَا تُطِعۡهُ وَٱسۡجُدۡۤ وَٱقۡتَرِب۩","page":598,"l1":3,"l2":3}]}