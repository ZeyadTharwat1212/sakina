{"ch":87,"verses":[{"v":1,"t":"Sabbihi isma rabbika alaAAla"},{"v":2,"t":"Allathee khalaqa fasawwa"},{"v":3,"t":"Waallathee qaddara fahada"},{"v":4,"t":"Waallathee akhraja almarAAa"},{"v":5,"t":"FajaAAalahu ghuthaan ahwa"},{"v":6,"t":"Sanuqrioka fala tansa"},{"v":7,"t":"Illa ma shaa Allahu innahu yaAAlamu aljahra wama yakhfa"},{"v":8,"t":"Wanuyassiruka lilyusra"},{"v":9,"t":"Fathakkir in nafaAAati alththikra"},{"v":10,"t":"Sayaththakkaru man yakhsha"},{"v":11,"t":"Wayatajannabuha alashqa"},{"v":12,"t":"Allathee yasla alnnara alkubra"},{"v":13,"t":"Thumma la yamootu feeha wala yahya"},{"v":14,"t":"Qad aflaha man tazakka"},{"v":15,"t":"Wathakara isma rabbihi fasalla"},{"v":16,"t":"Bal tuthiroona alhayata alddunya"},{"v":17,"t":"Waalakhiratu khayrun waabqa"},{"v":18,"t":"Inna hatha lafee alssuhufi aloola"},{"v":19,"t":"Suhufi ibraheema wamoosa"}]}