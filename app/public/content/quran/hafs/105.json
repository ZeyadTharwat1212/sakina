{"ch":105,"verses":[{"v":1,"t":"أَلَمۡ تَرَ كَيۡفَ فَعَلَ رَبُّكَ بِأَصۡحَٰبِ ٱلۡفِيلِ","page":601,"l1":13,"l2":13},{"v":2,"t":"أَلَمۡ يَجۡعَلۡ كَيۡدَهُمۡ فِي تَضۡلِيلٖ","page":601,"l1":13,"l2":14},{"v":3,"t":"وَأَرۡسَلَ عَلَيۡهِمۡ طَيۡرًا أَبَابِيلَ","page":601,"l1":14,"l2":14},{"v":4,"t":"تَرۡمِيهِم بِحِجَارَةٖ مِّن سِجِّيلٖ","page":601,"l1":15,"l2":15},{"v":5,"t":"فَجَعَلَهُمۡ كَعَصۡفٖ مَّأۡكُولِۭ","page":601,"l1":15,"l2":15}]}