{"ch":94,"verses":[{"v":1,"t":"أَلَمۡ نَشۡرَحۡ لَكَ صَدۡرَكَ","page":596,"l1":15,"l2":15},{"v":2,"t":"وَوَضَعۡنَا عَنكَ وِزۡرَكَ","page":596,"l1":15,"l2":15},{"v":3,"t":"ٱلَّذِيٓ أَنقَضَ ظَهۡرَكَ","page":597,"l1":1,"l2":1},{"v":4,"t":"وَرَفَعۡنَا لَكَ ذِكۡرَكَ","page":597,"l1":1,"l2":1},{"v":5,"t":"فَإِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرًا","page":597,"l1":1,"l2":1},{"v":6,"t":"إِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرٗا","page":597,"l1":2,"l2":2},{"v":7,"t":"فَإِذَا فَرَغۡتَ فَٱنصَبۡ","page":597,"l1":2,"l2":2},{"v":8,"t":"وَإِلَىٰ رَبِّكَ فَٱرۡغَب","page":597,"l1":2,"l2":2}]}