{"ch":107,"verses":[{"v":1,"t":"Tahukah kamu (orang) yang mendustakan agama"},{"v":2,"t":"Maka itulah orang yang menghardik anak yatim"},{"v":3,"t":"dan tidak mengajak memberi makan orang miskin"},{"v":4,"t":"Maka celakalah orang yang salat"},{"v":5,"t":"(yaitu) orang-orang yang lalai terhadap salatnya"},{"v":6,"t":"yang berbuat riya"},{"v":7,"t":"dan enggan (memberikan) bantuan"}]}