{"ch":84,"basmalaPrefixLen":39,"verses":[{"v":1,"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلسَّمَآءُ ٱنشَقَّتْ"},{"v":2,"t":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ"},{"v":3,"t":"وَإِذَا ٱلْأَرْضُ مُدَّتْ"},{"v":4,"t":"وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ"},{"v":5,"t":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ"},{"v":6,"t":"يَٰٓأَيُّهَا ٱلْإِنسَٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدْحًا فَمُلَٰقِيهِ"},{"v":7,"t":"فَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ بِيَمِينِهِۦ"},{"v":8,"t":"فَسَوْفَ يُحَاسَبُ حِسَابًا يَسِيرًا"},{"v":9,"t":"وَيَنقَلِبُ إِلَىٰٓ أَهْلِهِۦ مَسْرُورًا"},{"v":10,"t":"وَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ وَرَآءَ ظَهْرِهِۦ"},{"v":11,"t":"فَسَوْفَ يَدْعُوا۟ ثُبُورًا"},{"v":12,"t":"وَيَصْلَىٰ سَعِيرًا"},{"v":13,"t":"إِنَّهُۥ كَانَ فِىٓ أَهْلِهِۦ مَسْرُورًا"},{"v":14,"t":"إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ"},{"v":15,"t":"بَلَىٰٓ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرًا"},{"v":16,"t":"فَلَآ أُقْسِمُ بِٱلشَّفَقِ"},{"v":17,"t":"وَٱلَّيْلِ وَمَا وَسَقَ"},{"v":18,"t":"وَٱلْقَمَرِ إِذَا ٱتَّسَقَ"},{"v":19,"t":"لَتَرْكَبُنَّ طَبَقًا عَن طَبَقٍ"},{"v":20,"t":"فَمَا لَهُمْ لَا يُؤْمِنُونَ"},{"v":21,"t":"وَإِذَا قُرِئَ عَلَيْهِمُ ٱلْقُرْءَانُ لَا يَسْجُدُونَ"},{"v":22,"t":"بَلِ ٱلَّذِينَ كَفَرُوا۟ يُكَذِّبُونَ"},{"v":23,"t":"وَٱللَّهُ أَعْلَمُ بِمَا يُوعُونَ"},{"v":24,"t":"فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍ"},{"v":25,"t":"إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ لَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۭ"}]}