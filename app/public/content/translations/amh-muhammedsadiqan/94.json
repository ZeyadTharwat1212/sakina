{"ch":94,"verses":[{"v":1,"t":"ልብህን ለአንተ አላሰፋንልህምን? (አስፍተንልሃል)፡፡"},{"v":2,"t":"ሸክምህንም ካንተ አውርደንልሃል፡፡"},{"v":3,"t":"ያንን ጀርባህን ያከበደውን (ሸክም)፡፡"},{"v":4,"t":"መወሳትህንም ላንተ ከፍ አድርገንልሃል፡፡"},{"v":5,"t":"ከችግርም ጋር ምቾት አልለ፡፡"},{"v":6,"t":"ከችግር ጋር በእርግጥ ምቾት አልለ፡፡"},{"v":7,"t":"በጨረስክም ጊዜ ልፋ፡፡ (ቀጥል)፡፡"},{"v":8,"t":"ወደ ጌታህም ብቻ ከጅል፡፡"}]}