{"ch":88,"verses":[{"v":1,"t":"Aləmi Bürüyənin xəbəri sənə gəlib çatdımı"},{"v":2,"t":"O gün neçə-neçə üzlər zəlil olub yerə dikiləcək"},{"v":3,"t":"üzülüb əldən düşəcək"},{"v":4,"t":"çox qızmar oda girəcək"},{"v":5,"t":"qaynar çeşmədən içirdiləcəkdir"},{"v":6,"t":"Onlara daridən başqa bir yemək verilməyəcəkdir"},{"v":7,"t":"O onları nə doydurar, nə də aclıqdan xilas edər"},{"v":8,"t":"O gün neçəsinin üzündə fərəh görünəcək"},{"v":9,"t":"dünyadakı səylərindən məmnun qalacaq"},{"v":10,"t":"uca Cənnətdə olacaq"},{"v":11,"t":"orada faydasız söz eşitməyəcəkdir"},{"v":12,"t":"Orada axar çeşmələr vardır"},{"v":13,"t":"Orada hündür taxtlar"},{"v":14,"t":"düzülmüş piyalələr"},{"v":15,"t":"yan-yana qoyulmuş yastıqlar"},{"v":16,"t":"və döşəmələrə sərilmiş xalçalar vardır"},{"v":17,"t":"Məgər onlar dəvənin necə yaradıldığını görmürlər"},{"v":18,"t":"Göyün necə yüksəldiyini görmürlər"},{"v":19,"t":"Dağların necə sancıldığını görmürlər"},{"v":20,"t":"Yerin necə döşədildiyini görmürlər"},{"v":21,"t":"Onlara nəsihət ver! Sən yalnız nəsihətçisən"},{"v":22,"t":"Sən onların üstündə hökmdar deyilsən"},{"v":23,"t":"Lakin üz döndərib küfr edəni"},{"v":24,"t":"Allah ən şiddətli əzabla cəzalandırar"},{"v":25,"t":"Şübhəsiz ki, onların dönüşü Bizədir"},{"v":26,"t":"Sonra onları sorğu-suala çəkmək də Bizə aiddir"}]}