{"ch":109,"verses":[{"v":1,"t":"قُلۡ يَٰٓأَيُّهَا ٱلۡكَٰفِرُونَ","page":603,"l1":3,"l2":3},{"v":2,"t":"لَآ أَعۡبُدُ مَا تَعۡبُدُونَ","page":603,"l1":3,"l2":3},{"v":3,"t":"وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ","page":603,"l1":4,"l2":4},{"v":4,"t":"وَلَآ أَنَا۠ عَابِدٞ مَّا عَبَدتُّمۡ","page":603,"l1":4,"l2":4},{"v":5,"t":"وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ","page":603,"l1":5,"l2":5},{"v":6,"t":"لَكُمۡ دِينُكُمۡ وَلِيَ دِينِ","page":603,"l1":5,"l2":5}]}