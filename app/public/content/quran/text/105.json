{"ch":105,"basmalaPrefixLen":39,"verses":[{"v":1,"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَٰبِ ٱلْفِيلِ"},{"v":2,"t":"أَلَمْ يَجْعَلْ كَيْدَهُمْ فِى تَضْلِيلٍ"},{"v":3,"t":"وَأَرْسَلَ عَلَيْهِمْ طَيْرًا أَبَابِيلَ"},{"v":4,"t":"تَرْمِيهِم بِحِجَارَةٍ مِّن سِجِّيلٍ"},{"v":5,"t":"فَجَعَلَهُمْ كَعَصْفٍ مَّأْكُولٍۭ"}]}