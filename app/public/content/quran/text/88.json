{"ch":88,"basmalaPrefixLen":39,"verses":[{"v":1,"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَٰشِيَةِ"},{"v":2,"t":"وُجُوهٌ يَوْمَئِذٍ خَٰشِعَةٌ"},{"v":3,"t":"عَامِلَةٌ نَّاصِبَةٌ"},{"v":4,"t":"تَصْلَىٰ نَارًا حَامِيَةً"},{"v":5,"t":"تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍ"},{"v":6,"t":"لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍ"},{"v":7,"t":"لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍ"},{"v":8,"t":"وُجُوهٌ يَوْمَئِذٍ نَّاعِمَةٌ"},{"v":9,"t":"لِّسَعْيِهَا رَاضِيَةٌ"},{"v":10,"t":"فِى جَنَّةٍ عَالِيَةٍ"},{"v":11,"t":"لَّا تَسْمَعُ فِيهَا لَٰغِيَةً"},{"v":12,"t":"فِيهَا عَيْنٌ جَارِيَةٌ"},{"v":13,"t":"فِيهَا سُرُرٌ مَّرْفُوعَةٌ"},{"v":14,"t":"وَأَكْوَابٌ مَّوْضُوعَةٌ"},{"v":15,"t":"وَنَمَارِقُ مَصْفُوفَةٌ"},{"v":16,"t":"وَزَرَابِىُّ مَبْثُوثَةٌ"},{"v":17,"t":"أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ"},{"v":18,"t":"وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ"},{"v":19,"t":"وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ"},{"v":20,"t":"وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ"},{"v":21,"t":"فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌ"},{"v":22,"t":"لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ"},{"v":23,"t":"إِلَّا مَن تَوَلَّىٰ وَكَفَرَ"},{"v":24,"t":"فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ"},{"v":25,"t":"إِنَّ إِلَيْنَآ إِيَابَهُمْ"},{"v":26,"t":"ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم"}]}