{"ch":111,"verses":[{"v":1,"t":"تَبَّتۡ يَدَآ أَبِي لَهَبٖ وَتَبَّ","page":603,"l1":13,"l2":13},{"v":2,"t":"مَآ أَغۡنَىٰ عَنۡهُ مَالُهُۥ وَمَا كَسَبَ","page":603,"l1":13,"l2":13},{"v":3,"t":"سَيَصۡلَىٰ نَارٗا ذَاتَ لَهَبٖ","page":603,"l1":14,"l2":14},{"v":4,"t":"وَٱمۡرَأَتُهُۥ حَمَّالَةَ ٱلۡحَطَبِ","page":603,"l1":14,"l2":14},{"v":5,"t":"فِي جِيدِهَا حَبۡلٞ مِّن مَّسَدِۭ","page":603,"l1":15,"l2":15}]}