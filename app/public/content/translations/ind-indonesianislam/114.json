{"ch":114,"verses":[{"v":1,"t":"Katakanlah, \"Aku berlindung kepada Tuhannya manusia"},{"v":2,"t":"Raja manusia"},{"v":3,"t":"sembahan manusia"},{"v":4,"t":"dari kejahatan (bisikan) setan yang bersembunyi"},{"v":5,"t":"yang membisikkan (kejahatan) ke dalam dada manusia"},{"v":6,"t":"dari (golongan) jin dan manusia"}]}