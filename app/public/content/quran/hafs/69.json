{"ch":69,"verses":[{"v":1,"t":"ٱلۡحَآقَّةُ","page":566,"l1":12,"l2":12},{"v":2,"t":"مَا ٱلۡحَآقَّةُ","page":566,"l1":12,"l2":12},{"v":3,"t":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡحَآقَّةُ","page":566,"l1":12,"l2":12},{"v":4,"t":"كَذَّبَتۡ ثَمُودُ وَعَادُۢ بِٱلۡقَارِعَةِ","page":566,"l1":12,"l2":13},{"v":5,"t":"فَأَمَّا ثَمُودُ فَأُهۡلِكُواْ بِٱلطَّاغِيَةِ","page":566,"l1":13,"l2":13},{"v":6,"t":"وَأَمَّا عَادٞ فَأُهۡلِكُواْ بِرِيحٖ صَرۡصَرٍ عَاتِيَةٖ","page":566,"l1":13,"l2":14},{"v":7,"t":"سَخَّرَهَا عَلَيۡهِمۡ سَبۡعَ لَيَالٖ وَثَمَٰنِيَةَ أَيَّامٍ حُسُومٗاۖ فَتَرَى ٱلۡقَوۡمَ فِيهَا صَرۡعَىٰ كَأَنَّهُمۡ أَعۡجَازُ نَخۡلٍ خَاوِيَةٖ","page":566,"l1":14,"l2":15},{"v":8,"t":"فَهَلۡ تَرَىٰ لَهُم مِّنۢ بَاقِيَةٖ","page":566,"l1":15,"l2":15},{"v":9,"t":"وَجَآءَ فِرۡعَوۡنُ وَمَن قَبۡلَهُۥ وَٱلۡمُؤۡتَفِكَٰتُ بِٱلۡخَاطِئَةِ","page":567,"l1":1,"l2":1},{"v":10,"t":"فَعَصَوۡاْ رَسُولَ رَبِّهِمۡ فَأَخَذَهُمۡ أَخۡذَةٗ رَّابِيَةً","page":567,"l1":1,"l2":2},{"v":11,"t":"إِنَّا لَمَّا طَغَا ٱلۡمَآءُ حَمَلۡنَٰكُمۡ فِي ٱلۡجَارِيَةِ","page":567,"l1":2,"l2":3},{"v":12,"t":"لِنَجۡعَلَهَا لَكُمۡ تَذۡكِرَةٗ وَتَعِيَهَآ أُذُنٞ وَٰعِيَةٞ","page":567,"l1":3,"l2":3},{"v":13,"t":"فَإِذَا نُفِخَ فِي ٱلصُّورِ نَفۡخَةٞ وَٰحِدَةٞ","page":567,"l1":3,"l2":4},{"v":14,"t":"وَحُمِلَتِ ٱلۡأَرۡضُ وَٱلۡجِبَالُ فَدُكَّتَا دَكَّةٗ وَٰحِدَةٗ","page":567,"l1":4,"l2":5},{"v":15,"t":"فَيَوۡمَئِذٖ وَقَعَتِ ٱلۡوَاقِعَةُ","page":567,"l1":5,"l2":5},{"v":16,"t":"وَٱنشَقَّتِ ٱلسَّمَآءُ فَهِيَ يَوۡمَئِذٖ وَاهِيَةٞ","page":567,"l1":5,"l2":6},{"v":17,"t":"وَٱلۡمَلَكُ عَلَىٰٓ أَرۡجَآئِهَاۚ وَيَحۡمِلُ عَرۡشَ رَبِّكَ فَوۡقَهُمۡ يَوۡمَئِذٖ ثَمَٰنِيَةٞ","page":567,"l1":6,"l2":7},{"v":18,"t":"يَوۡمَئِذٖ تُعۡرَضُونَ لَا تَخۡفَىٰ مِنكُمۡ خَافِيَةٞ","page":567,"l1":7,"l2":7},{"v":19,"t":"فَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ بِيَمِينِهِۦ فَيَقُولُ هَآؤُمُ ٱقۡرَءُواْ كِتَٰبِيَهۡ","page":567,"l1":7,"l2":8},{"v":20,"t":"إِنِّي ظَنَنتُ أَنِّي مُلَٰقٍ حِسَابِيَهۡ","page":567,"l1":8,"l2":9},{"v":21,"t":"فَهُوَ فِي عِيشَةٖ رَّاضِيَةٖ","page":567,"l1":9,"l2":9},{"v":22,"t":"فِي جَنَّةٍ عَالِيَةٖ","page":567,"l1":9,"l2":9},{"v":23,"t":"قُطُوفُهَا دَانِيَةٞ","page":567,"l1":9,"l2":10},{"v":24,"t":"كُلُواْ وَٱشۡرَبُواْ هَنِيٓـَٔۢا بِمَآ أَسۡلَفۡتُمۡ فِي ٱلۡأَيَّامِ ٱلۡخَالِيَةِ","page":567,"l1":10,"l2":10},{"v":25,"t":"وَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ بِشِمَالِهِۦ فَيَقُولُ يَٰلَيۡتَنِي لَمۡ أُوتَ كِتَٰبِيَهۡ","page":567,"l1":11,"l2":11},{"v":26,"t":"وَلَمۡ أَدۡرِ مَا حِسَابِيَهۡ","page":567,"l1":11,"l2":12},{"v":27,"t":"يَٰلَيۡتَهَا كَانَتِ ٱلۡقَاضِيَةَ","page":567,"l1":12,"l2":12},{"v":28,"t":"مَآ أَغۡنَىٰ عَنِّي مَالِيَهۡۜ","page":567,"l1":12,"l2":12},{"v":29,"t":"هَلَكَ عَنِّي سُلۡطَٰنِيَهۡ","page":567,"l1":12,"l2":13},{"v":30,"t":"خُذُوهُ فَغُلُّوهُ","page":567,"l1":13,"l2":13},{"v":31,"t":"ثُمَّ ٱلۡجَحِيمَ صَلُّوهُ","page":567,"l1":13,"l2":13},{"v":32,"t":"ثُمَّ فِي سِلۡسِلَةٖ ذَرۡعُهَا سَبۡعُونَ ذِرَاعٗا فَٱسۡلُكُوهُ","page":567,"l1":13,"l2":14},{"v":33,"t":"إِنَّهُۥ كَانَ لَا يُؤۡمِنُ بِٱللَّهِ ٱلۡعَظِيمِ","page":567,"l1":14,"l2":14},{"v":34,"t":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ","page":567,"l1":15,"l2":15},{"v":35,"t":"فَلَيۡسَ لَهُ ٱلۡيَوۡمَ هَٰهُنَا حَمِيمٞ","page":567,"l1":15,"l2":15},{"v":36,"t":"وَلَا طَعَامٌ إِلَّا مِنۡ غِسۡلِينٖ","page":568,"l1":1,"l2":1},{"v":37,"t":"لَّا يَأۡكُلُهُۥٓ إِلَّا ٱلۡخَٰطِـُٔونَ","page":568,"l1":1,"l2":1},{"v":38,"t":"فَلَآ أُقۡسِمُ بِمَا تُبۡصِرُونَ","page":568,"l1":1,"l2":2},{"v":39,"t":"وَمَا لَا تُبۡصِرُونَ","page":568,"l1":2,"l2":2},{"v":40,"t":"إِنَّهُۥ لَقَوۡلُ رَسُولٖ كَرِيمٖ","page":568,"l1":2,"l2":2},{"v":41,"t":"وَمَا هُوَ بِقَوۡلِ شَاعِرٖۚ قَلِيلٗا مَّا تُؤۡمِنُونَ","page":568,"l1":2,"l2":3},{"v":42,"t":"وَلَا بِقَوۡلِ كَاهِنٖۚ قَلِيلٗا مَّا تَذَكَّرُونَ","page":568,"l1":3,"l2":3},{"v":43,"t":"تَنزِيلٞ مِّن رَّبِّ ٱلۡعَٰلَمِينَ","page":568,"l1":4,"l2":4},{"v":44,"t":"وَلَوۡ تَقَوَّلَ عَلَيۡنَا بَعۡضَ ٱلۡأَقَاوِيلِ","page":568,"l1":4,"l2":4},{"v":45,"t":"لَأَخَذۡنَا مِنۡهُ بِٱلۡيَمِينِ","page":568,"l1":5,"l2":5},{"v":46,"t":"ثُمَّ لَقَطَعۡنَا مِنۡهُ ٱلۡوَتِينَ","page":568,"l1":5,"l2":5},{"v":47,"t":"فَمَا مِنكُم مِّنۡ أَحَدٍ عَنۡهُ حَٰجِزِينَ","page":568,"l1":5,"l2":6},{"v":48,"t":"وَإِنَّهُۥ لَتَذۡكِرَةٞ لِّلۡمُتَّقِينَ","page":568,"l1":6,"l2":6},{"v":49,"t":"وَإِنَّا لَنَعۡلَمُ أَنَّ مِنكُم مُّكَذِّبِينَ","page":568,"l1":6,"l2":7},{"v":50,"t":"وَإِنَّهُۥ لَحَسۡرَةٌ عَلَى ٱلۡكَٰفِرِينَ","page":568,"l1":7,"l2":7},{"v":51,"t":"وَإِنَّهُۥ لَحَقُّ ٱلۡيَقِينِ","page":568,"l1":8,"l2":8},{"v":52,"t":"فَسَبِّحۡ بِٱسۡمِ رَبِّكَ ٱلۡعَظِيمِ","page":568,"l1":8,"l2":8}]}