{"ch":97,"verses":[{"v":1,"t":"إِنَّآ أَنزَلۡنَٰهُ فِي لَيۡلَةِ ٱلۡقَدۡرِ","page":598,"l1":6,"l2":6},{"v":2,"t":"وَمَآ أَدۡرَىٰكَ مَا لَيۡلَةُ ٱلۡقَدۡرِ","page":598,"l1":6,"l2":6},{"v":3,"t":"لَيۡلَةُ ٱلۡقَدۡرِ خَيۡرٞ مِّنۡ أَلۡفِ شَهۡرٖ","page":598,"l1":7,"l2":7},{"v":4,"t":"تَنَزَّلُ ٱلۡمَلَٰٓئِكَةُ وَٱلرُّوحُ فِيهَا بِإِذۡنِ رَبِّهِم مِّن كُلِّ أَمۡرٖ","page":598,"l1":7,"l2":8},{"v":5,"t":"سَلَٰمٌ هِيَ حَتَّىٰ مَطۡلَعِ ٱلۡفَجۡرِ","page":598,"l1":8,"l2":8}]}