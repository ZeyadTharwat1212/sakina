{"ch":87,"verses":[{"v":1,"t":"سَبِّحِ ٱسۡمَ رَبِّكَ ٱلۡأَعۡلَى","page":591,"l1":12,"l2":12},{"v":2,"t":"ٱلَّذِي خَلَقَ فَسَوَّىٰ","page":591,"l1":12,"l2":12},{"v":3,"t":"وَٱلَّذِي قَدَّرَ فَهَدَىٰ","page":591,"l1":12,"l2":13},{"v":4,"t":"وَٱلَّذِيٓ أَخۡرَجَ ٱلۡمَرۡعَىٰ","page":591,"l1":13,"l2":13},{"v":5,"t":"فَجَعَلَهُۥ غُثَآءً أَحۡوَىٰ","page":591,"l1":13,"l2":13},{"v":6,"t":"سَنُقۡرِئُكَ فَلَا تَنسَىٰٓ","page":591,"l1":14,"l2":14},{"v":7,"t":"إِلَّا مَا شَآءَ ٱللَّهُۚ إِنَّهُۥ يَعۡلَمُ ٱلۡجَهۡرَ وَمَا يَخۡفَىٰ","page":591,"l1":14,"l2":14},{"v":8,"t":"وَنُيَسِّرُكَ لِلۡيُسۡرَىٰ","page":591,"l1":15,"l2":15},{"v":9,"t":"فَذَكِّرۡ إِن نَّفَعَتِ ٱلذِّكۡرَىٰ","page":591,"l1":15,"l2":15},{"v":10,"t":"سَيَذَّكَّرُ مَن يَخۡشَىٰ","page":591,"l1":15,"l2":15},{"v":11,"t":"وَيَتَجَنَّبُهَا ٱلۡأَشۡقَى","page":592,"l1":1,"l2":1},{"v":12,"t":"ٱلَّذِي يَصۡلَى ٱلنَّارَ ٱلۡكُبۡرَىٰ","page":592,"l1":1,"l2":1},{"v":13,"t":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحۡيَىٰ","page":592,"l1":1,"l2":2},{"v":14,"t":"قَدۡ أَفۡلَحَ مَن تَزَكَّىٰ","page":592,"l1":2,"l2":2},{"v":15,"t":"وَذَكَرَ ٱسۡمَ رَبِّهِۦ فَصَلَّىٰ","page":592,"l1":2,"l2":2},{"v":16,"t":"بَلۡ تُؤۡثِرُونَ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا","page":592,"l1":3,"l2":3},{"v":17,"t":"وَٱلۡأٓخِرَةُ خَيۡرٞ وَأَبۡقَىٰٓ","page":592,"l1":3,"l2":3},{"v":18,"t":"إِنَّ هَٰذَا لَفِي ٱلصُّحُفِ ٱلۡأُولَىٰ","page":592,"l1":3,"l2":4},{"v":19,"t":"صُحُفِ إِبۡرَٰهِيمَ وَمُوسَىٰ","page":592,"l1":4,"l2":4}]}