{"ch":107,"verses":[{"v":1,"t":"أَرَءَيۡتَ ٱلَّذِي يُكَذِّبُ بِٱلدِّينِ","page":602,"l1":8,"l2":8},{"v":2,"t":"فَذَٰلِكَ ٱلَّذِي يَدُعُّ ٱلۡيَتِيمَ","page":602,"l1":8,"l2":9},{"v":3,"t":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ","page":602,"l1":9,"l2":9},{"v":4,"t":"فَوَيۡلٞ لِّلۡمُصَلِّينَ","page":602,"l1":9,"l2":10},{"v":5,"t":"ٱلَّذِينَ هُمۡ عَن صَلَاتِهِمۡ سَاهُونَ","page":602,"l1":10,"l2":10},{"v":6,"t":"ٱلَّذِينَ هُمۡ يُرَآءُونَ","page":602,"l1":11,"l2":11},{"v":7,"t":"وَيَمۡنَعُونَ ٱلۡمَاعُونَ","page":602,"l1":11,"l2":11}]}