{"ch":56,"basmalaPrefixLen":39,"verses":[{"v":1,"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا وَقَعَتِ ٱلْوَاقِعَةُ"},{"v":2,"t":"لَيْسَ لِوَقْعَتِهَا كَاذِبَةٌ"},{"v":3,"t":"خَافِضَةٌ رَّافِعَةٌ"},{"v":4,"t":"إِذَا رُجَّتِ ٱلْأَرْضُ رَجًّا"},{"v":5,"t":"وَبُسَّتِ ٱلْجِبَالُ بَسًّا"},{"v":6,"t":"فَكَانَتْ هَبَآءً مُّنۢبَثًّا"},{"v":7,"t":"وَكُنتُمْ أَزْوَٰجًا ثَلَٰثَةً"},{"v":8,"t":"فَأَصْحَٰبُ ٱلْمَيْمَنَةِ مَآ أَصْحَٰبُ ٱلْمَيْمَنَةِ"},{"v":9,"t":"وَأَصْحَٰبُ ٱلْمَشْـَٔمَةِ مَآ أَصْحَٰبُ ٱلْمَشْـَٔمَةِ"},{"v":10,"t":"وَٱلسَّٰبِقُونَ ٱلسَّٰبِقُونَ"},{"v":11,"t":"أُو۟لَٰٓئِكَ ٱلْمُقَرَّبُونَ"},{"v":12,"t":"فِى جَنَّٰتِ ٱلنَّعِيمِ"},{"v":13,"t":"ثُلَّةٌ مِّنَ ٱلْأَوَّلِينَ"},{"v":14,"t":"وَقَلِيلٌ مِّنَ ٱلْـَٔاخِرِينَ"},{"v":15,"t":"عَلَىٰ سُرُرٍ مَّوْضُونَةٍ"},{"v":16,"t":"مُّتَّكِـِٔينَ عَلَيْهَا مُتَقَٰبِلِينَ"},{"v":17,"t":"يَطُوفُ عَلَيْهِمْ وِلْدَٰنٌ مُّخَلَّدُونَ"},{"v":18,"t":"بِأَكْوَابٍ وَأَبَارِيقَ وَكَأْسٍ مِّن مَّعِينٍ"},{"v":19,"t":"لَّا يُصَدَّعُونَ عَنْهَا وَلَا يُنزِفُونَ"},{"v":20,"t":"وَفَٰكِهَةٍ مِّمَّا يَتَخَيَّرُونَ"},{"v":21,"t":"وَلَحْمِ طَيْرٍ مِّمَّا يَشْتَهُونَ"},{"v":22,"t":"وَحُورٌ عِينٌ"},{"v":23,"t":"كَأَمْثَٰلِ ٱللُّؤْلُؤِ ٱلْمَكْنُونِ"},{"v":24,"t":"جَزَآءًۢ بِمَا كَانُوا۟ يَعْمَلُونَ"},{"v":25,"t":"لَا يَسْمَعُونَ فِيهَا لَغْوًا وَلَا تَأْثِيمًا"},{"v":26,"t":"إِلَّا قِيلًا سَلَٰمًا سَلَٰمًا"},{"v":27,"t":"وَأَصْحَٰبُ ٱلْيَمِينِ مَآ أَصْحَٰبُ ٱلْيَمِينِ"},{"v":28,"t":"فِى سِدْرٍ مَّخْضُودٍ"},{"v":29,"t":"وَطَلْحٍ مَّنضُودٍ"},{"v":30,"t":"وَظِلٍّ مَّمْدُودٍ"},{"v":31,"t":"وَمَآءٍ مَّسْكُوبٍ"},{"v":32,"t":"وَفَٰكِهَةٍ كَثِيرَةٍ"},{"v":33,"t":"لَّا مَقْطُوعَةٍ وَلَا مَمْنُوعَةٍ"},{"v":34,"t":"وَفُرُشٍ مَّرْفُوعَةٍ"},{"v":35,"t":"إِنَّآ أَنشَأْنَٰهُنَّ إِنشَآءً"},{"v":36,"t":"فَجَعَلْنَٰهُنَّ أَبْكَارًا"},{"v":37,"t":"عُرُبًا أَتْرَابًا"},{"v":38,"t":"لِّأَصْحَٰبِ ٱلْيَمِينِ"},{"v":39,"t":"ثُلَّةٌ مِّنَ ٱلْأَوَّلِينَ"},{"v":40,"t":"وَثُلَّةٌ مِّنَ ٱلْـَٔاخِرِينَ"},{"v":41,"t":"وَأَصْحَٰبُ ٱلشِّمَالِ مَآ أَصْحَٰبُ ٱلشِّمَالِ"