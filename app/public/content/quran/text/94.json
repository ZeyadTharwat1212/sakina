{"ch":94,"basmalaPrefixLen":39,"verses":[{"v":1,"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ"},{"v":2,"t":"وَوَضَعْنَا عَنكَ وِزْرَكَ"},{"v":3,"t":"ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ"},{"v":4,"t":"وَرَفَعْنَا لَكَ ذِكْرَكَ"},{"v":5,"t":"فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا"},{"v":6,"t":"إِنَّ مَعَ ٱلْعُسْرِ يُسْرًا"},{"v":7,"t":"فَإِذَا فَرَغْتَ فَٱنصَبْ"},{"v":8,"t":"وَإِلَىٰ رَبِّكَ فَٱرْغَب"}]}