{"ch":86,"verses":[{"v":1,"t":"وَٱلسَّمَآءِ وَٱلطَّارِقِ","page":591,"l1":3,"l2":3},{"v":2,"t":"وَمَآ أَدۡرَىٰكَ مَا ٱلطَّارِقُ","page":591,"l1":3,"l2":3},{"v":3,"t":"ٱلنَّجۡمُ ٱلثَّاقِبُ","page":591,"l1":3,"l2":3},{"v":4,"t":"إِن كُلُّ نَفۡسٖ لَّمَّا عَلَيۡهَا حَافِظٞ","page":591,"l1":4,"l2":4},{"v":5,"t":"فَلۡيَنظُرِ ٱلۡإِنسَٰنُ مِمَّ خُلِقَ","page":591,"l1":4,"l2":4},{"v":6,"t":"خُلِقَ مِن مَّآءٖ دَافِقٖ","page":591,"l1":5,"l2":5},{"v":7,"t":"يَخۡرُجُ مِنۢ بَيۡنِ ٱلصُّلۡبِ وَٱلتَّرَآئِبِ","page":591,"l1":5,"l2":5},{"v":8,"t":"إِنَّهُۥ عَلَىٰ رَجۡعِهِۦ لَقَادِرٞ","page":591,"l1":5,"l2":6},{"v":9,"t":"يَوۡمَ تُبۡلَى ٱلسَّرَآئِرُ","page":591,"l1":6,"l2":6},{"v":10,"t":"فَمَا لَهُۥ مِن قُوَّةٖ وَلَا نَاصِرٖ","page":591,"l1":6,"l2":7},{"v":11,"t":"وَٱلسَّمَآءِ ذَاتِ ٱلرَّجۡعِ","page":591,"l1":7,"l2":7},{"v":12,"t":"وَٱلۡأَرۡضِ ذَاتِ ٱلصَّدۡعِ","page":591,"l1":7,"l2":7},{"v":13,"t":"إِنَّهُۥ لَقَوۡلٞ فَصۡلٞ","page":591,"l1":8,"l2":8},{"v":14,"t":"وَمَا هُوَ بِٱلۡهَزۡلِ","page":591,"l1":8,"l2":8},{"v":15,"t":"إِنَّهُمۡ يَكِيدُونَ كَيۡدٗا","page":591,"l1":8,"l2":8},{"v":16,"t":"وَأَكِيدُ كَيۡدٗا","page":591,"l1":9,"l2":9},{"v":17,"t":"فَمَهِّلِ ٱلۡكَٰفِرِينَ أَمۡهِلۡهُمۡ رُوَيۡدَۢا","page":591,"l1":9,"l2":9}]}