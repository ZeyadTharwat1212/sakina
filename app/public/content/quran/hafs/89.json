{"ch":89,"verses":[{"v":1,"t":"وَٱلۡفَجۡرِ","page":593,"l1":5,"l2":5},{"v":2,"t":"وَلَيَالٍ عَشۡرٖ","page":593,"l1":5,"l2":5},{"v":3,"t":"وَٱلشَّفۡعِ وَٱلۡوَتۡرِ","page":593,"l1":5,"l2":5},{"v":4,"t":"وَٱلَّيۡلِ إِذَا يَسۡرِ","page":593,"l1":5,"l2":5},{"v":5,"t":"هَلۡ فِي ذَٰلِكَ قَسَمٞ لِّذِي حِجۡرٍ","page":593,"l1":6,"l2":6},{"v":6,"t":"أَلَمۡ تَرَ كَيۡفَ فَعَلَ رَبُّكَ بِعَادٍ","page":593,"l1":6,"l2":6},{"v":7,"t":"إِرَمَ ذَاتِ ٱلۡعِمَادِ","page":593,"l1":7,"l2":7},{"v":8,"t":"ٱلَّتِي لَمۡ يُخۡلَقۡ مِثۡلُهَا فِي ٱلۡبِلَٰدِ","page":593,"l1":7,"l2":7},{"v":9,"t":"وَثَمُودَ ٱلَّذِينَ جَابُواْ ٱلصَّخۡرَ بِٱلۡوَادِ","page":593,"l1":7,"l2":8},{"v":10,"t":"وَفِرۡعَوۡنَ ذِي ٱلۡأَوۡتَادِ","page":593,"l1":8,"l2":8},{"v":11,"t":"ٱلَّذِينَ طَغَوۡاْ فِي ٱلۡبِلَٰدِ","page":593,"l1":8,"l2":9},{"v":12,"t":"فَأَكۡثَرُواْ فِيهَا ٱلۡفَسَادَ","page":593,"l1":9,"l2":9},{"v":13,"t":"فَصَبَّ عَلَيۡهِمۡ رَبُّكَ سَوۡطَ عَذَابٍ","page":593,"l1":9,"l2":10},{"v":14,"t":"إِنَّ رَبَّكَ لَبِٱلۡمِرۡصَادِ","page":593,"l1":10,"l2":10},{"v":15,"t":"فَأَمَّا ٱلۡإِنسَٰنُ إِذَا مَا ٱبۡتَلَىٰهُ رَبُّهُۥ فَأَكۡرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّيٓ أَكۡرَمَنِ","page":593,"l1":10,"l2":11},{"v":16,"t":"وَأَمَّآ إِذَا مَا ٱبۡتَلَىٰهُ فَقَدَرَ عَلَيۡهِ رِزۡقَهُۥ فَيَقُولُ رَبِّيٓ أَهَٰنَنِ","page":593,"l1":11,"l2":12},{"v":17,"t":"كـَلَّاۖ بَل لَّا تُكۡرِمُونَ ٱلۡيَتِيمَ","page":593,"l1":12,"l2":13},{"v":18,"t":"وَلَا تَحَٰٓضُّونَ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ","page":593,"l1":13,"l2":13},{"v":19,"t":"وَتَأۡكُلُونَ ٱلتُّرَاثَ أَكۡلٗا لَّمّٗا","page":593,"l1":13,"l2":14},{"v":20,"t":"وَتُحِبُّونَ ٱلۡمَالَ حُبّٗا جَمّٗا","page":593,"l1":14,"l2":14},{"v":21,"t":"كـَلَّآۖ إِذَا دُكَّتِ ٱلۡأَرۡضُ دَكّٗا دَكّٗا","page":593,"l1":14,"l2":15},{"v":22,"t":"وَجَآءَ رَبُّكَ وَٱلۡمَلَكُ صَفّٗا صَفّٗا","page":593,"l1":15,"l2":15},{"v":23,"t":"وَجِاْيٓءَ يَوۡمَئِذِۭ بِجَهَنَّمَۚ يَوۡمَئِذٖ يَتَذَكَّرُ ٱلۡإِنسَٰنُ وَأَنَّىٰ لَهُ ٱلذِّكۡرَىٰ","page":594,"l1":1,"l2":2},{"v":24,"t":"يَقُولُ يَٰلَيۡتَنِي قَدَّمۡتُ لِحَيَاتِي","page":594,"l1":2,"l2":2},{"v":25,"t":"فَيَوۡمَئِذٖ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٞ","page":594,"l1":2,"l2":3},{"v":26,"t":"وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٞ","page":594,"l1":3,"l2":3},{"v":27,"t":"يَٰٓأَيَّتُهَا ٱلنَّفۡسُ ٱلۡمُطۡمَئِنَّةُ","page":594,"l1":3,"l2":4},{"v":28,"t":"ٱرۡجِعِيٓ إِلَىٰ رَبِّكِ رَاضِيَةٗ مَّرۡضِيَّةٗ","page":594,"l1":4,"l2":4},{"v":29,"t":"فَٱدۡخُلِي فِي عِبَٰدِي","page":594,"l1":5,"l2":5},{"v":30,"t":"وَٱدۡخُلِي جَنَّتِي","page":594,"l1":5,"l2":5}]}