{"ch":107,"basmalaPrefixLen":39,"verses":[{"v":1,"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ"},{"v":2,"t":"فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ"},{"v":3,"t":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ"},{"v":4,"t":"فَوَيْلٌ لِّلْمُصَلِّينَ"},{"v":5,"t":"ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ"},{"v":6,"t":"ٱلَّذِينَ هُمْ يُرَآءُونَ"},{"v":7,"t":"وَيَمْنَعُونَ ٱلْمَاعُونَ"}]}