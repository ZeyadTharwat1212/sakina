{"ch":93,"verses":[{"v":1,"t":"وَٱلضُّحَىٰ","page":596,"l1":8,"l2":8},{"v":2,"t":"وَٱلَّيۡلِ إِذَا سَجَىٰ","page":596,"l1":8,"l2":8},{"v":3,"t":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ","page":596,"l1":8,"l2":8},{"v":4,"t":"وَلَلۡأٓخِرَةُ خَيۡرٞ لَّكَ مِنَ ٱلۡأُولَىٰ","page":596,"l1":9,"l2":9},{"v":5,"t":"وَلَسَوۡفَ يُعۡطِيكَ رَبُّكَ فَتَرۡضَىٰٓ","page":596,"l1":9,"l2":10},{"v":6,"t":"أَلَمۡ يَجِدۡكَ يَتِيمٗا فَـَٔاوَىٰ","page":596,"l1":10,"l2":10},{"v":7,"t":"وَوَجَدَكَ ضَآلّٗا فَهَدَىٰ","page":596,"l1":10,"l2":10},{"v":8,"t":"وَوَجَدَكَ عَآئِلٗا فَأَغۡنَىٰ","page":596,"l1":11,"l2":11},{"v":9,"t":"فَأَمَّا ٱلۡيَتِيمَ فَلَا تَقۡهَرۡ","page":596,"l1":11,"l2":11},{"v":10,"t":"وَأَمَّا ٱلسَّآئِلَ فَلَا تَنۡهَرۡ","page":596,"l1":12,"l2":12},{"v":11,"t":"وَأَمَّا بِنِعۡمَةِ رَبِّكَ فَحَدِّثۡ","page":596,"l1":12,"l2":12}]}