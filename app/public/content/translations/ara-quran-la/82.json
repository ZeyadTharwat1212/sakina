{"ch":82,"verses":[{"v":1,"t":"Itha alssamao infatarat"},{"v":2,"t":"Waitha alkawakibu intatharat"},{"v":3,"t":"Waitha albiharu fujjirat"},{"v":4,"t":"Waitha alqubooru buAAthirat"},{"v":5,"t":"AAalimat nafsun ma qaddamat waakhkharat"},{"v":6,"t":"Ya ayyuha alinsanu ma gharraka birabbika alkareemi"},{"v":7,"t":"Allathee khalaqaka fasawwaka faAAadalaka"},{"v":8,"t":"Fee ayyi sooratin ma shaa rakkabaka"},{"v":9,"t":"Kalla bal tukaththiboona bialddeeni"},{"v":10,"t":"Wainna AAalaykum lahafitheena"},{"v":11,"t":"Kiraman katibeena"},{"v":12,"t":"YaAAlamoona ma tafAAaloona"},{"v":13,"t":"Inna alabrara lafee naAAeemin"},{"v":14,"t":"Wainna alfujjara lafee jaheemin"},{"v":15,"t":"Yaslawnaha yawma alddeeni"},{"v":16,"t":"Wama hum AAanha bighaibeena"},{"v":17,"t":"Wama adraka ma yawmu alddeeni"},{"v":18,"t":"Thumma ma adraka ma yawmu alddeeni"},{"v":19,"t":"Yawma la tamliku nafsun linafsin shayan waalamru yawmaithin lillahi"}]}