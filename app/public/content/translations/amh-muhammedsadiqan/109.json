{"ch":109,"verses":[{"v":1,"t":"በላቸው «እናንተ ከሓዲዎች ሆይ"},{"v":2,"t":"«ያንን የምትግገዙትን (ጣዖት አሁን) አልግገዛም፡፡"},{"v":3,"t":"«እናንተም እኔ የምግገዛውን (አምላክም አሁን) ተገዢዎች አይደላችሁም፡፡"},{"v":4,"t":"«እኔም ያንን የተገዛችሁትን (ወደፊት) ተገዢ አይደለሁም፡፡"},{"v":5,"t":"«እናንተም እኔ የምግገዛውን (ወደፊት) ተገዢዎች አይደላችሁም፡፡"},{"v":6,"t":"«ለእናንተ ሃይማኖታችሁ አልላችሁ፡፡ ለእኔም ሃይማኖቴ አለኝ፡፡"}]}