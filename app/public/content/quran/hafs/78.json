{"ch":78,"verses":[{"v":1,"t":"عَمَّ يَتَسَآءَلُونَ","page":582,"l1":3,"l2":3},{"v":2,"t":"عَنِ ٱلنَّبَإِ ٱلۡعَظِيمِ","page":582,"l1":3,"l2":3},{"v":3,"t":"ٱلَّذِي هُمۡ فِيهِ مُخۡتَلِفُونَ","page":582,"l1":3,"l2":3},{"v":4,"t":"كـَلَّا سَيَعۡلَمُونَ","page":582,"l1":4,"l2":4},{"v":5,"t":"ثُمَّ كـَلَّا سَيَعۡلَمُونَ","page":582,"l1":4,"l2":4},{"v":6,"t":"أَلَمۡ نَجۡعَلِ ٱلۡأَرۡضَ مِهَٰدٗا","page":582,"l1":4,"l2":4},{"v":7,"t":"وَٱلۡجِبَالَ أَوۡتَادٗا","page":582,"l1":5,"l2":5},{"v":8,"t":"وَخَلَقۡنَٰكُمۡ أَزۡوَٰجٗا","page":582,"l1":5,"l2":5},{"v":9,"t":"وَجَعَلۡنَا نَوۡمَكُمۡ سُبَاتٗا","page":582,"l1":5,"l2":5},{"v":10,"t":"وَجَعَلۡنَا ٱلَّيۡلَ لِبَاسٗا","page":582,"l1":6,"l2":6},{"v":11,"t":"وَجَعَلۡنَا ٱلنَّهَارَ مَعَاشٗا","page":582,"l1":6,"l2":6},{"v":12,"t":"وَبَنَيۡنَا فَوۡقَكُمۡ سَبۡعٗا شِدَادٗا","page":582,"l1":6,"l2":7},{"v":13,"t":"وَجَعَلۡنَا سِرَاجٗا وَهَّاجٗا","page":582,"l1":7,"l2":7},{"v":14,"t":"وَأَنزَلۡنَا مِنَ ٱلۡمُعۡصِرَٰتِ مَآءٗ ثَجَّاجٗا","page":582,"l1":7,"l2":8},{"v":15,"t":"لِّنُخۡرِجَ بِهِۦ حَبّٗا وَنَبَاتٗا","page":582,"l1":8,"l2":8},{"v":16,"t":"وَجَنَّٰتٍ أَلۡفَافًا","page":582,"l1":8,"l2":9},{"v":17,"t":"إِنَّ يَوۡمَ ٱلۡفَصۡلِ كَانَ مِيقَٰتٗا","page":582,"l1":9,"l2":9},{"v":18,"t":"يَوۡمَ يُنفَخُ فِي ٱلصُّورِ فَتَأۡتُونَ أَفۡوَاجٗا","page":582,"l1":9,"l2":10},{"v":19,"t":"وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتۡ أَبۡوَٰبٗا","page":582,"l1":10,"l2":10},{"v":20,"t":"وَسُيِّرَتِ ٱلۡجِبَالُ فَكَانَتۡ سَرَابًا","page":582,"l1":10,"l2":11},{"v":21,"t":"إِنَّ جَهَنَّمَ كَانَتۡ مِرۡصَادٗا","page":582,"l1":11,"l2":11},{"v":22,"t":"لِّلطَّٰغِينَ مَـَٔابٗا","page":582,"l1":11,"l2":12},{"v":23,"t":"لَّٰبِثِينَ فِيهَآ أَحۡقَابٗا","page":582,"l1":12,"l2":12},{"v":24,"t":"لَّا يَذُوقُونَ فِيهَا بَرۡدٗا وَلَا شَرَابًا","page":582,"l1":12,"l2":13},{"v":25,"t":"إِلَّا حَمِيمٗا وَغَسَّاقٗا","page":582,"l1":13,"l2":13},{"v":26,"t":"جَزَآءٗ وِفَاقًا","page":582,"l1":13,"l2":13},{"v":27,"t":"إِنَّهُمۡ كَانُواْ لَا يَرۡجُونَ حِسَابٗا","page":582,"l1":13,"l2":14},{"v":28,"t":"وَكَذَّبُواْ بِـَٔايَٰتِنَا كِذَّابٗا","page":582,"l1":14,"l2":14},{"v":29,"t":"وَكُلَّ شَيۡءٍ أَحۡصَيۡنَٰهُ كِتَٰبٗا","page":582,"l1":14,"l2":15},{"v":30,"t":"فَذُوقُواْ فَلَن نَّزِيدَكُمۡ إِلَّا عَذَابًا","page":582,"l1":15,"l2":15},{"v":31,"t":"إِنَّ لِلۡمُتَّقِينَ مَفَازًا","page":583,"l1":1,"l2":1},{"v":32,"t":"حَدَآئِقَ وَأَعۡنَٰبٗا","page":583,"l1":1,"l2":1},{"v":33,"t":"وَكَوَاعِبَ أَتۡرَابٗا","page":583,"l1":1,"l2":1},{"v":34,"t":"وَكَأۡسٗا دِهَاقٗا","page":583,"l1":1,"l2":2},{"v":35,"t":"لَّا يَسۡمَعُونَ فِيهَا لَغۡوٗا وَلَا كِذَّٰبٗا","page":583,"l1":2,"l2":2},{"v":36,"t":"جَزَآءٗ مِّن رَّبِّكَ عَطَآءً حِسَابٗا","page":583,"l1":2,"l2":3},{"v":37,"t":"رَّبِّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا بَيۡنَهُمَا ٱلرَّحۡمَٰنِۖ لَا يَمۡلِكُونَ مِنۡهُ خِطَابٗا","page":583,"l1":3,"l2":4},{"v":38,"t":"يَوۡمَ يَقُومُ ٱلرُّوحُ وَٱلۡمَلَٰٓئِكَةُ صَفّٗاۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنۡ أَذِنَ لَهُ ٱلرَّحۡمَٰنُ وَقَالَ صَوَابٗا","page":583,"l1":4,"l2":5},{"v":39,"t":"ذَٰلِكَ ٱلۡيَوۡمُ ٱلۡحَقُّۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا","page":583,"l1":5,"l2":6},{"v":40,"t":"إِنَّآ أَنذَرۡنَٰكُمۡ عَذَابٗا قَرِيبٗا يَوۡمَ يَنظُرُ ٱلۡمَرۡءُ مَا قَدَّمَتۡ يَدَاهُ وَيَقُولُ ٱلۡكَافِرُ يَٰلَيۡتَنِي كُنتُ تُرَٰبَۢا","page":583,"l1":6,"l2":7}]}