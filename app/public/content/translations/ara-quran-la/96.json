{"ch":96,"verses":[{"v":1,"t":"Iqra biismi rabbika allathee khalaqa"},{"v":2,"t":"Khalaqa alinsana min AAalaqin"},{"v":3,"t":"Iqra warabbuka alakramu"},{"v":4,"t":"Allathee AAallama bialqalami"},{"v":5,"t":"AAallama alinsana ma lam yaAAlam"},{"v":6,"t":"Kalla inna alinsana layatgha"},{"v":7,"t":"An raahu istaghna"},{"v":8,"t":"Inna ila rabbika alrrujAAa"},{"v":9,"t":"Araayta allathee yanha"},{"v":10,"t":"AAabdan itha salla"},{"v":11,"t":"Araayta in kana AAala alhuda"},{"v":12,"t":"Aw amara bialttaqwa"},{"v":13,"t":"Araayta in kaththaba watawalla"},{"v":14,"t":"Alam yaAAlam bianna Allaha yara"},{"v":15,"t":"Kalla lain lam yantahi lanasfaAAan bialnnasiyati"},{"v":16,"t":"Nasiyatin kathibatin khatiatin"},{"v":17,"t":"FalyadAAu nadiyahu"},{"v":18,"t":"SanadAAu alzzabaniyata"},{"v":19,"t":"Kalla la tutiAAhu waosjud waiqtarib"}]}