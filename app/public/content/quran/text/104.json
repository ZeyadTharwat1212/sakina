{"ch":104,"basmalaPrefixLen":39,"verses":[{"v":1,"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَيْلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةٍ"},{"v":2,"t":"ٱلَّذِى جَمَعَ مَالًا وَعَدَّدَهُۥ"},{"v":3,"t":"يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ"},{"v":4,"t":"كَلَّا لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ"},{"v":5,"t":"وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ"},{"v":6,"t":"نَارُ ٱللَّهِ ٱلْمُوقَدَةُ"},{"v":7,"t":"ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ"},{"v":8,"t":"إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌ"},{"v":9,"t":"فِى عَمَدٍ مُّمَدَّدَةٍۭ"}]}