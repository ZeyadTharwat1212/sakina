{"chapter":0,"hadiths":[{"id":1,"ar":"لَیْسَ الْخَبَرُ کَالْمُعَایَنَةِ","narrator":null},{"id":2,"ar":"الْحَرْبُ خُدَعَةٌ","narrator":null},{"id":3,"ar":"الْمُسْلِمُ مِرْآةُ الْمُسْلِمِ","narrator":null},{"id":4,"ar":"الْمُسْتَشَارُ مُؤتَمَنٌ","narrator":null},{"id":5,"ar":"الدَّالُّ عَلَی الْخَیْرِ کَفَاعِلِهِ","narrator":null},{"id":6,"ar":"إِسْتَعِیْنُوْا عَلَی الْحَوَائِجِ بِالْکِتْمَانِ","narrator":null},{"id":7,"ar":"إِتَّقُوْا النَّارَ وَلَوْ بِشِقِّ تَمْرَةٍ","narrator":null},{"id":8,"ar":"الدُّنْیَا سِجْنُ الْمُؤمِنِ وَ جَنَّةُ الْکَافِرِ","narrator":null},{"id":9,"ar":"الْحَیَاءُ خَیْرٌ کُلُّهُ","narrator":null},{"id":10,"ar":"عِدَةُ الْمُؤمِنِ کَاَخْذِ الْکَفِّ","narrator":null},{"id":11,"ar":"لَا یَحِلُّ لِمُؤمِنٍ اَنْ یَّجُهْرَ أخَاهُ فَوقَ ثَلَاثَةِ أیَّامٍ","narrator":null},{"id":12,"ar":"لَیْسَ مِنَّا مَنْ غَشَّنَا","narrator":null},{"id":13,"ar":"مَا قَلَّ وَكَفَى خَيْرٌ مِمَّا كَثُرَ وَأَلْهَى","narrator":null},{"id":14,"ar":"الرَّاجِعُ فِيْ هِبَتِهِ کَالرَّاجِعِ فِيْ قَیْئِهِ","narrator":null},{"id":15,"ar":"الْبَلَاءُ مُوَکِّلٌ بِالْمَنْطِقِ","narrator":null},{"id":16,"ar":"النَّاسُ کَأسْنَانِ الْمُشْطِ","narrator":null},{"id":17,"ar":"الْغِنَى غِنَى النَّفْسِ","narrator":null},{"id":18,"ar":"الْسَّعِیْدُ مَنْ وُّعِظَ بِغَیْرِهِ","narrator":null},{"id":19,"ar":"وَ إِنَّ مِنَ الشِّعْرِ لَحِکْمَةً وَاِنَّ مِنَ الْبَیَانِ لَسِحْرًا","narrator":null},{"id":20,"ar":"عَفْوُ الْمُلُوْكِ إِبْقَاءٌ لِلْمُلْكِ","narrator":null},{"id":21,"ar":"اَلْمَرْءُ مَعَ مَنْ أَحَبَّ","narrator":null},{"id":22,"ar":"مَا هَلَكَ إمْرُؤٌ عَرَفَ قَدْرَهُ","narrator":null},{"id":23,"ar":"اَلْوَلَدُ لِلْفِرَاشِ وَ لِلْعَاهِرِ الْحَجَرُ","narrator":null},{"id":24,"ar":"الْیَدُ الْعُلْیَا خَیْرٌ مِّنَ الْیَدِ السُّفْلَی","narrator":null},{"id":25,"ar":"لَا شَکَرَ اللهَ مَنْ لَّا یَشْکُرُ النَّاسَ","narrator":null},{"id":26,"ar":"حُبُّكَ الشَّيْءَ یُعْمِيْ وَ یُصِمُّ","narrator":null},{"id":27,"ar":"جُبِلَتِ الْقُلُوبُ عَلی حُبَّ مَنْ اَحْسَنَ اِلَیْهَا وَ بُغْضِ مَنْ اَسَاءَ اِلَیْهَا","narrator":null},{"id":28,"ar":"الْتَّائِبُ مِنَ الذَّنْبِ کَمَنْ لَا ذَنْبَ لَهُ","narrator":null},{"id":29,"ar":"الشَّاهِدُ یَرَی مَا لَا یَرَاهُ الْغَائِبُ","narrator":null},{"id":30,"ar":"اِذا جَاءَکُمْ کَرِیْمُ قَوْمٍ فَاَکْرِمُوهُ","narrator":null},{"id":31,"ar":"الْیَمِینُ الْفَاجِرَةُ تَدَعُ الدِّیَارَ الْبَلَاقِعَ","narrator":null},{"id":32,"ar":"مَنْ قُتِلَ دُونَ مَالِهِ فَهُوَ شَهِیْدٌ","narrator":null},{"id":33,"ar":"الْاَعْمَالُ بِالنِّیَّةِ","narrator":null},{"id":34,"ar":"سَیِّدُ الْقَوْمِ خَادِمُهُمْ","narrator":null},{"id":35,"ar":"خَیْرُ الْأُمُوْرِ أَوْسَطُهَا","narrator":null},{"id":36,"ar":"اَللَّهُمَّ بَارِكْ فِیْ أُمَّتِیْ فِی بُکُوْرِهَا یَوْمَ الْخَمِیْسِ","narrator":null},{"id":37,"ar":"کَادَ الْفَقْرُ أَنْ یَکُوْنَ کُفْرًا","narrator":null},{"id":38,"ar":"الْسَّفَرُ قِطْعَةٌ مِّنَ الْعَذَابِ","narrator":null},{"id":39,"ar":"خَیْرُ زَّادِ الْتَّقْوَی","narrator":null},{"id":40,"ar":"الْمَجَالِسُ بِالْاَمَانَةِ","narrator":null}]}