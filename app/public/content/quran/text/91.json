{"ch":91,"basmalaPrefixLen":39,"verses":[{"v":1,"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلشَّمْسِ وَضُحَىٰهَا"},{"v":2,"t":"وَٱلْقَمَرِ إِذَا تَلَىٰهَا"},{"v":3,"t":"وَٱلنَّهَارِ إِذَا جَلَّىٰهَا"},{"v":4,"t":"وَٱلَّيْلِ إِذَا يَغْشَىٰهَا"},{"v":5,"t":"وَٱلسَّمَآءِ وَمَا بَنَىٰهَا"},{"v":6,"t":"وَٱلْأَرْضِ وَمَا طَحَىٰهَا"},{"v":7,"t":"وَنَفْسٍ وَمَا سَوَّىٰهَا"},{"v":8,"t":"فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَىٰهَا"},{"v":9,"t":"قَدْ أَفْلَحَ مَن زَكَّىٰهَا"},{"v":10,"t":"وَقَدْ خَابَ مَن دَسَّىٰهَا"},{"v":11,"t":"كَذَّبَتْ ثَمُودُ بِطَغْوَىٰهَآ"},{"v":12,"t":"إِذِ ٱنۢبَعَثَ أَشْقَىٰهَا"},{"v":13,"t":"فَقَالَ لَهُمْ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقْيَٰهَا"},{"v":14,"t":"فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّىٰهَا"},{"v":15,"t":"وَلَا يَخَافُ عُقْبَٰهَا"}]}