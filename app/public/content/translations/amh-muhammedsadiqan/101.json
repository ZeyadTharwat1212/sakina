{"ch":101,"verses":[{"v":1,"t":"ቆርቋሪይቱ (ጩኸት)፤"},{"v":2,"t":"ምን አስደናቂ ቆርቋሪ ናት"},{"v":3,"t":"ቆርቋሪይቱም ምን እንደኾነች ምን አሳወቀህ"},{"v":4,"t":"ሰዎች እንደ ተበታተነ ቢራቢሮ (ወይም ኩብኩባ) በሚኾኑበት ቀን፤"},{"v":5,"t":"ጋራዎችም እንደ ተነደፈ ሱፍ በሚኾኑበት (ቀን ልቦችን በድንጋጤ ትቆረቁራለች፡፡)"},{"v":6,"t":"ሚዛኖቹ የከበዱለት ሰውማ፤"},{"v":7,"t":"እርሱ በምትወደድ ኑሮ ውስጥ ይኾናል፡፡"},{"v":8,"t":"ሚዛኖቹም የቀለሉበት ሰውማ፤"},{"v":9,"t":"መኖሪያው ሃዊያህ ናት"},{"v":10,"t":"እርሷም ምን እንደ ኾነች ምን አሳወቀህ"},{"v":11,"t":"(እርሷ) በጣም ተኳሳ እሳት ናት፡፡"}]}