{"ch":95,"verses":[{"v":1,"t":"وَٱلتِّينِ وَٱلزَّيۡتُونِ","page":597,"l1":5,"l2":5},{"v":2,"t":"وَطُورِ سِينِينَ","page":597,"l1":5,"l2":5},{"v":3,"t":"وَهَٰذَا ٱلۡبَلَدِ ٱلۡأَمِينِ","page":597,"l1":5,"l2":5},{"v":4,"t":"لَقَدۡ خَلَقۡنَا ٱلۡإِنسَٰنَ فِيٓ أَحۡسَنِ تَقۡوِيمٖ","page":597,"l1":6,"l2":6},{"v":5,"t":"ثُمَّ رَدَدۡنَٰهُ أَسۡفَلَ سَٰفِلِينَ","page":597,"l1":6,"l2":6},{"v":6,"t":"إِلَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ فَلَهُمۡ أَجۡرٌ غَيۡرُ مَمۡنُونٖ","page":597,"l1":7,"l2":7},{"v":7,"t":"فَمَا يُكَذِّبُكَ بَعۡدُ بِٱلدِّينِ","page":597,"l1":8,"l2":8},{"v":8,"t":"أَلَيۡسَ ٱللَّهُ بِأَحۡكَمِ ٱلۡحَٰكِمِينَ","page":597,"l1":8,"l2":8}]}