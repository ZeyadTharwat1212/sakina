{"ch":79,"verses":[{"v":1,"t":"وَٱلنَّٰزِعَٰتِ غَرۡقٗا","page":583,"l1":10,"l2":10},{"v":2,"t":"وَٱلنَّٰشِطَٰتِ نَشۡطٗا","page":583,"l1":10,"l2":10},{"v":3,"t":"وَٱلسَّٰبِحَٰتِ سَبۡحٗا","page":583,"l1":10,"l2":10},{"v":4,"t":"فَٱلسَّٰبِقَٰتِ سَبۡقٗا","page":583,"l1":11,"l2":11},{"v":5,"t":"فَٱلۡمُدَبِّرَٰتِ أَمۡرٗا","page":583,"l1":11,"l2":11},{"v":6,"t":"يَوۡمَ تَرۡجُفُ ٱلرَّاجِفَةُ","page":583,"l1":11,"l2":11},{"v":7,"t":"تَتۡبَعُهَا ٱلرَّادِفَةُ","page":583,"l1":12,"l2":12},{"v":8,"t":"قُلُوبٞ يَوۡمَئِذٖ وَاجِفَةٌ","page":583,"l1":12,"l2":12},{"v":9,"t":"أَبۡصَٰرُهَا خَٰشِعَةٞ","page":583,"l1":12,"l2":12},{"v":10,"t":"يَقُولُونَ أَءِنَّا لَمَرۡدُودُونَ فِي ٱلۡحَافِرَةِ","page":583,"l1":13,"l2":13},{"v":11,"t":"أَءِذَا كُنَّا عِظَٰمٗا نَّخِرَةٗ","page":583,"l1":13,"l2":13},{"v":12,"t":"قَالُواْ تِلۡكَ إِذٗا كَرَّةٌ خَاسِرَةٞ","page":583,"l1":13,"l2":14},{"v":13,"t":"فَإِنَّمَا هِيَ زَجۡرَةٞ وَٰحِدَةٞ","page":583,"l1":14,"l2":14},{"v":14,"t":"فَإِذَا هُم بِٱلسَّاهِرَةِ","page":583,"l1":14,"l2":14},{"v":15,"t":"هَلۡ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ","page":583,"l1":15,"l2":15},{"v":16,"t":"إِذۡ نَادَىٰهُ رَبُّهُۥ بِٱلۡوَادِ ٱلۡمُقَدَّسِ طُوًى","page":583,"l1":15,"l2":15},{"v":17,"t":"ٱذۡهَبۡ إِلَىٰ فِرۡعَوۡنَ إِنَّهُۥ طَغَىٰ","page":584,"l1":1,"l2":1},{"v":18,"t":"فَقُلۡ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ","page":584,"l1":1,"l2":1},{"v":19,"t":"وَأَهۡدِيَكَ إِلَىٰ رَبِّكَ فَتَخۡشَىٰ","page":584,"l1":2,"l2":2},{"v":20,"t":"فَأَرَىٰهُ ٱلۡأٓيَةَ ٱلۡكُبۡرَىٰ","page":584,"l1":2,"l2":2},{"v":21,"t":"فَكَذَّبَ وَعَصَىٰ","page":584,"l1":3,"l2":3},{"v":22,"t":"ثُمَّ أَدۡبَرَ يَسۡعَىٰ","page":584,"l1":3,"l2":3},{"v":23,"t":"فَحَشَرَ فَنَادَىٰ","page":584,"l1":3,"l2":3},{"v":24,"t":"فَقَالَ أَنَا۠ رَبُّكُمُ ٱلۡأَعۡلَىٰ","page":584,"l1":4,"l2":4},{"v":25,"t":"فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلۡأٓخِرَةِ وَٱلۡأُولَىٰٓ","page":584,"l1":4,"l2":4},{"v":26,"t":"إِنَّ فِي ذَٰلِكَ لَعِبۡرَةٗ لِّمَن يَخۡشَىٰٓ","page":584,"l1":5,"l2":5},{"v":27,"t":"ءَأَنتُمۡ أَشَدُّ خَلۡقًا أَمِ ٱلسَّمَآءُۚ بَنَىٰهَا","page":584,"l1":5,"l2":6},{"v":28,"t":"رَفَعَ سَمۡكَهَا فَسَوَّىٰهَا","page":584,"l1":6,"l2":6},{"v":29,"t":"وَأَغۡطَشَ لَيۡلَهَا وَأَخۡرَجَ ضُحَىٰهَا","page":584,"l1":6,"l2":7},{"v":30,"t":"وَٱلۡأَرۡضَ بَعۡدَ ذَٰلِكَ دَحَىٰهَآ","page":584,"l1":7,"l2":7},{"v":31,"t":"أَخۡرَجَ مِنۡهَا مَآءَهَا وَمَرۡعَىٰهَا","page":584,"l1":7,"l2":8},{"v":32,"t":"وَٱلۡجِبَالَ أَرۡسَىٰهَا","page":584,"l1":8,"l2":8},{"v":33,"t":"مَتَٰعٗا لَّكُمۡ وَلِأَنۡعَٰمِكُمۡ","page":584,"l1":8,"l2":8},{"v":34,"t":"فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلۡكُبۡرَىٰ","page":584,"l1":9,"l2":9},{"v":35,"t":"يَوۡمَ يَتَذَكَّرُ ٱلۡإِنسَٰنُ مَا سَعَىٰ","page":584,"l1":9,"l2":9},{"v":36,"t":"وَبُرِّزَتِ ٱلۡجَحِيمُ لِمَن يَرَىٰ","page":584,"l1":10,"l2":10},{"v":37,"t":"فَأَمَّا مَن طَغَىٰ","page":584,"l1":10,"l2":10},{"v":38,"t":"وَءَاثَرَ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا","page":584,"l1":10,"l2":11},{"v":39,"t":"فَإِنَّ ٱلۡجَحِيمَ هِيَ ٱلۡمَأۡوَىٰ","page":584,"l1":11,"l2":11},{"v":40,"t":"وَأَمَّا مَنۡ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفۡسَ عَنِ ٱلۡهَوَىٰ","page":584,"l1":11,"l2":12},{"v":41,"t":"فَإِنَّ ٱلۡجَنَّةَ هِيَ ٱلۡمَأۡوَىٰ","page":584,"l1":12,"l2":12},{"v":42,"t":"يَسۡـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرۡسَىٰهَا","page":584,"l1":13,"l2":13},{"v":43,"t":"فِيمَ أَنتَ مِن ذِكۡرَىٰهَآ","page":584,"l1":13,"l2":14},{"v":44,"t":"إِلَىٰ رَبِّكَ مُنتَهَىٰهَآ","page":584,"l1":14,"l2":14},{"v":45,"t":"إِنَّمَآ أَنتَ مُنذِرُ مَن يَخۡشَىٰهَا","page":584,"l1":14,"l2":14},{"v":46,"t":"كَأَنَّهُمۡ يَوۡمَ يَرَوۡنَهَا لَمۡ يَلۡبَثُوٓاْ إِلَّا عَشِيَّةً أَوۡ ضُحَىٰهَا","page":584,"l1":15,"l2":15}]}