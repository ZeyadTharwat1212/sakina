{"ch":113,"verses":[{"v":1,"t":"قُلۡ أَعُوذُ بِرَبِّ ٱلۡفَلَقِ","page":604,"l1":7,"l2":7},{"v":2,"t":"مِن شَرِّ مَا خَلَقَ","page":604,"l1":7,"l2":7},{"v":3,"t":"وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ","page":604,"l1":7,"l2":8},{"v":4,"t":"وَمِن شَرِّ ٱلنَّفَّٰثَٰتِ فِي ٱلۡعُقَدِ","page":604,"l1":8,"l2":8},{"v":5,"t":"وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ","page":604,"l1":9,"l2":9}]}