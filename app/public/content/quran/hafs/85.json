{"ch":85,"verses":[{"v":1,"t":"وَٱلسَّمَآءِ ذَاتِ ٱلۡبُرُوجِ","page":590,"l1":4,"l2":4},{"v":2,"t":"وَٱلۡيَوۡمِ ٱلۡمَوۡعُودِ","page":590,"l1":4,"l2":4},{"v":3,"t":"وَشَاهِدٖ وَمَشۡهُودٖ","page":590,"l1":4,"l2":4},{"v":4,"t":"قُتِلَ أَصۡحَٰبُ ٱلۡأُخۡدُودِ","page":590,"l1":5,"l2":5},{"v":5,"t":"ٱلنَّارِ ذَاتِ ٱلۡوَقُودِ","page":590,"l1":5,"l2":5},{"v":6,"t":"إِذۡ هُمۡ عَلَيۡهَا قُعُودٞ","page":590,"l1":5,"l2":6},{"v":7,"t":"وَهُمۡ عَلَىٰ مَا يَفۡعَلُونَ بِٱلۡمُؤۡمِنِينَ شُهُودٞ","page":590,"l1":6,"l2":6},{"v":8,"t":"وَمَا نَقَمُواْ مِنۡهُمۡ إِلَّآ أَن يُؤۡمِنُواْ بِٱللَّهِ ٱلۡعَزِيزِ ٱلۡحَمِيدِ","page":590,"l1":6,"l2":7},{"v":9,"t":"ٱلَّذِي لَهُۥ مُلۡكُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۚ وَٱللَّهُ عَلَىٰ كُلِّ شَيۡءٖ شَهِيدٌ","page":590,"l1":7,"l2":8},{"v":10,"t":"إِنَّ ٱلَّذِينَ فَتَنُواْ ٱلۡمُؤۡمِنِينَ وَٱلۡمُؤۡمِنَٰتِ ثُمَّ لَمۡ يَتُوبُواْ فَلَهُمۡ عَذَابُ جَهَنَّمَ وَلَهُمۡ عَذَابُ ٱلۡحَرِيقِ","page":590,"l1":8,"l2":10},{"v":11,"t":"إِنَّ ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ لَهُمۡ جَنَّٰتٞ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُۚ ذَٰلِكَ ٱلۡفَوۡزُ ٱلۡكَبِيرُ","page":590,"l1":10,"l2":11},{"v":12,"t":"إِنَّ بَطۡشَ رَبِّكَ لَشَدِيدٌ","page":590,"l1":11,"l2":12},{"v":13,"t":"إِنَّهُۥ هُوَ يُبۡدِئُ وَيُعِيدُ","page":590,"l1":12,"l2":12},{"v":14,"t":"وَهُوَ ٱلۡغَفُورُ ٱلۡوَدُودُ","page":590,"l1":12,"l2":12},{"v":15,"t":"ذُو ٱلۡعَرۡشِ ٱلۡمَجِيدُ","page":590,"l1":13,"l2":13},{"v":16,"t":"فَعَّالٞ لِّمَا يُرِيدُ","page":590,"l1":13,"l2":13},{"v":17,"t":"هَلۡ أَتَىٰكَ حَدِيثُ ٱلۡجُنُودِ","page":590,"l1":13,"l2":14},{"v":18,"t":"فِرۡعَوۡنَ وَثَمُودَ","page":590,"l1":14,"l2":14},{"v":19,"t":"بَلِ ٱلَّذِينَ كَفَرُواْ فِي تَكۡذِيبٖ","page":590,"l1":14,"l2":14},{"v":20,"t":"وَٱللَّهُ مِن وَرَآئِهِم مُّحِيطُۢ","page":590,"l1":14,"l2":15},{"v":21,"t":"بَلۡ هُوَ قُرۡءَانٞ مَّجِيدٞ","page":590,"l1":15,"l2":15},{"v":22,"t":"فِي لَوۡحٖ مَّحۡفُوظِۭ","page":590,"l1":15,"l2":15}]}