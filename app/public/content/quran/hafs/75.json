{"ch":75,"verses":[{"v":1,"t":"لَآ أُقۡسِمُ بِيَوۡمِ ٱلۡقِيَٰمَةِ","page":577,"l1":8,"l2":8},{"v":2,"t":"وَلَآ أُقۡسِمُ بِٱلنَّفۡسِ ٱللَّوَّامَةِ","page":577,"l1":8,"l2":8},{"v":3,"t":"أَيَحۡسَبُ ٱلۡإِنسَٰنُ أَلَّن نَّجۡمَعَ عِظَامَهُۥ","page":577,"l1":8,"l2":9},{"v":4,"t":"بَلَىٰ قَٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّيَ بَنَانَهُۥ","page":577,"l1":9,"l2":9},{"v":5,"t":"بَلۡ يُرِيدُ ٱلۡإِنسَٰنُ لِيَفۡجُرَ أَمَامَهُۥ","page":577,"l1":9,"l2":10},{"v":6,"t":"يَسۡـَٔلُ أَيَّانَ يَوۡمُ ٱلۡقِيَٰمَةِ","page":577,"l1":10,"l2":10},{"v":7,"t":"فَإِذَا بَرِقَ ٱلۡبَصَرُ","page":577,"l1":10,"l2":11},{"v":8,"t":"وَخَسَفَ ٱلۡقَمَرُ","page":577,"l1":11,"l2":11},{"v":9,"t":"وَجُمِعَ ٱلشَّمۡسُ وَٱلۡقَمَرُ","page":577,"l1":11,"l2":11},{"v":10,"t":"يَقُولُ ٱلۡإِنسَٰنُ يَوۡمَئِذٍ أَيۡنَ ٱلۡمَفَرُّ","page":577,"l1":11,"l2":12},{"v":11,"t":"كـَلَّا لَا وَزَرَ","page":577,"l1":12,"l2":12},{"v":12,"t":"إِلَىٰ رَبِّكَ يَوۡمَئِذٍ ٱلۡمُسۡتَقَرُّ","page":577,"l1":12,"l2":12},{"v":13,"t":"يُنَبَّؤُاْ ٱلۡإِنسَٰنُ يَوۡمَئِذِۭ بِمَا قَدَّمَ وَأَخَّرَ","page":577,"l1":12,"l2":13},{"v":14,"t":"بَلِ ٱلۡإِنسَٰنُ عَلَىٰ نَفۡسِهِۦ بَصِيرَةٞ","page":577,"l1":13,"l2":13},{"v":15,"t":"وَلَوۡ أَلۡقَىٰ مَعَاذِيرَهُۥ","page":577,"l1":14,"l2":14},{"v":16,"t":"لَا تُحَرِّكۡ بِهِۦ لِسَانَكَ لِتَعۡجَلَ بِهِۦٓ","page":577,"l1":14,"l2":14},{"v":17,"t":"إِنَّ عَلَيۡنَا جَمۡعَهُۥ وَقُرۡءَانَهُۥ","page":577,"l1":14,"l2":15},{"v":18,"t":"فَإِذَا قَرَأۡنَٰهُ فَٱتَّبِعۡ قُرۡءَانَهُۥ","page":577,"l1":15,"l2":15},{"v":19,"t":"ثُمَّ إِنَّ عَلَيۡنَا بَيَانَهُۥ","page":577,"l1":15,"l2":15},{"v":20,"t":"كـَلَّا بَلۡ تُحِبُّونَ ٱلۡعَاجِلَةَ","page":578,"l1":1,"l2":1},{"v":21,"t":"وَتَذَرُونَ ٱلۡأٓخِرَةَ","page":578,"l1":1,"l2":1},{"v":22,"t":"وُجُوهٞ يَوۡمَئِذٖ نَّاضِرَةٌ","page":578,"l1":1,"l2":2},{"v":23,"t":"إِلَىٰ رَبِّهَا نَاظِرَةٞ","page":578,"l1":2,"l2":2},{"v":24,"t":"وَوُجُوهٞ يَوۡمَئِذِۭ بَاسِرَةٞ","page":578,"l1":2,"l2":2},{"v":25,"t":"تَظُنُّ أَن يُفۡعَلَ بِهَا فَاقِرَةٞ","page":578,"l1":2,"l2":3},{"v":26,"t":"كـَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِيَ","page":578,"l1":3,"l2":3},{"v":27,"t":"وَقِيلَ مَنۡۜ رَاقٖ","page":578,"l1":3,"l2":3},{"v":28,"t":"وَظَنَّ أَنَّهُ ٱلۡفِرَاقُ","page":578,"l1":3,"l2":4},{"v":29,"t":"وَٱلۡتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ","page":578,"l1":4,"l2":4},{"v":30,"t":"إِلَىٰ رَبِّكَ يَوۡمَئِذٍ ٱلۡمَسَاقُ","page":578,"l1":4,"l2":4},{"v":31,"t":"فَلَا صَدَّقَ وَلَا صَلَّىٰ","page":578,"l1":5,"l2":5},{"v":32,"t":"وَلَٰكِن كَذَّبَ وَتَوَلَّىٰ","page":578,"l1":5,"l2":5},{"v":33,"t":"ثُمَّ ذَهَبَ إِلَىٰٓ أَهۡلِهِۦ يَتَمَطَّىٰٓ","page":578,"l1":5,"l2":6},{"v":34,"t":"أَوۡلَىٰ لَكَ فَأَوۡلَىٰ","page":578,"l1":6,"l2":6},{"v":35,"t":"ثُمَّ أَوۡلَىٰ لَكَ فَأَوۡلَىٰٓ","page":578,"l1":6,"l2":6},{"v":36,"t":"أَيَحۡسَبُ ٱلۡإِنسَٰنُ أَن يُتۡرَكَ سُدًى","page":578,"l1":6,"l2":7},{"v":37,"t":"أَلَمۡ يَكُ نُطۡفَةٗ مِّن مَّنِيّٖ يُمۡنَىٰ","page":578,"l1":7,"l2":7},{"v":38,"t":"ثُمَّ كَانَ عَلَقَةٗ فَخَلَقَ فَسَوَّىٰ","page":578,"l1":8,"l2":8},{"v":39,"t":"فَجَعَلَ مِنۡهُ ٱلزَّوۡجَيۡنِ ٱلذَّكَرَ وَٱلۡأُنثَىٰٓ","page":578,"l1":8,"l2":9},{"v":40,"t":"أَلَيۡسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰٓ أَن يُحۡـِۧيَ ٱلۡمَوۡتَىٰ","page":578,"l1":9,"l2":9}]}