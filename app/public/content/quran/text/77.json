{"ch":77,"basmalaPrefixLen":39,"verses":[{"v":1,"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْمُرْسَلَٰتِ عُرْفًا"},{"v":2,"t":"فَٱلْعَٰصِفَٰتِ عَصْفًا"},{"v":3,"t":"وَٱلنَّٰشِرَٰتِ نَشْرًا"},{"v":4,"t":"فَٱلْفَٰرِقَٰتِ فَرْقًا"},{"v":5,"t":"فَٱلْمُلْقِيَٰتِ ذِكْرًا"},{"v":6,"t":"عُذْرًا أَوْ نُذْرًا"},{"v":7,"t":"إِنَّمَا تُوعَدُونَ لَوَٰقِعٌ"},{"v":8,"t":"فَإِذَا ٱلنُّجُومُ طُمِسَتْ"},{"v":9,"t":"وَإِذَا ٱلسَّمَآءُ فُرِجَتْ"},{"v":10,"t":"وَإِذَا ٱلْجِبَالُ نُسِفَتْ"},{"v":11,"t":"وَإِذَا ٱلرُّسُلُ أُقِّتَتْ"},{"v":12,"t":"لِأَىِّ يَوْمٍ أُجِّلَتْ"},{"v":13,"t":"لِيَوْمِ ٱلْفَصْلِ"},{"v":14,"t":"وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلْفَصْلِ"},{"v":15,"t":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"},{"v":16,"t":"أَلَمْ نُهْلِكِ ٱلْأَوَّلِينَ"},{"v":17,"t":"ثُمَّ نُتْبِعُهُمُ ٱلْـَٔاخِرِينَ"},{"v":18,"t":"كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ"},{"v":19,"t":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"},{"v":20,"t":"أَلَمْ نَخْلُقكُّم مِّن مَّآءٍ مَّهِينٍ"},{"v":21,"t":"فَجَعَلْنَٰهُ فِى قَرَارٍ مَّكِينٍ"},{"v":22,"t":"إِلَىٰ قَدَرٍ مَّعْلُومٍ"},{"v":23,"t":"فَقَدَرْنَا فَنِعْمَ ٱلْقَٰدِرُونَ"},{"v":24,"t":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"},{"v":25,"t":"أَلَمْ نَجْعَلِ ٱلْأَرْضَ كِفَاتًا"},{"v":26,"t":"أَحْيَآءً وَأَمْوَٰتًا"},{"v":27,"t":"وَجَعَلْنَا فِيهَا رَوَٰسِىَ شَٰمِخَٰتٍ وَأَسْقَيْنَٰكُم مَّآءً فُرَاتًا"},{"v":28,"t":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"},{"v":29,"t":"ٱنطَلِقُوٓا۟ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ"},{"v":30,"t":"ٱنطَلِقُوٓا۟ إِلَىٰ ظِلٍّ ذِى ثَلَٰثِ شُعَبٍ"},{"v":31,"t":"لَّا ظَلِيلٍ وَلَا يُغْنِى مِنَ ٱللَّهَبِ"},{"v":32,"t":"إِنَّهَا تَرْمِى بِشَرَرٍ كَٱلْقَصْرِ"},{"v":33,"t":"كَأَنَّهُۥ جِمَٰلَتٌ صُفْرٌ"},{"v":34,"t":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"},{"v":35,"t":"هَٰذَا يَوْمُ لَا يَنطِقُونَ"},{"v":36,"t":"وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ"},{"v":37,"t":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"},{"v":38,"t":"هَٰذَا يَوْمُ ٱلْفَصْلِ جَمَعْنَٰكُمْ وَٱلْأَوَّلِينَ"},{"v":39,"t":"فَإِن كَانَ لَكُمْ كَيْدٌ فَكِيدُونِ"},{"v":40,"t":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"},{"v":41,"t":"إِنَّ ٱلْمُتَّقِينَ فِى ظِلَٰلٍ وَعُيُونٍ"},{"v":42,"t":"وَفَوَٰكِهَ مِمَّا يَشْتَهُونَ"},{"v":43,"t":"كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَا كُنتُمْ تَعْمَلُونَ"},{"v":44,"t":"إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ"},{"v":45,"t":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"},{"v":46,"t":"كُلُوا۟ وَتَمَتَّعُوا۟ قَلِيلًا إِنَّكُم مُّجْرِمُونَ"},{"v":47,"t":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"},{"v":48,"t":"وَإِذَا قِيلَ لَهُمُ ٱرْكَعُوا۟ لَا يَرْكَعُونَ"},{"v":49,"t":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"},{"v":50,"t":"فَبِأَىِّ حَدِيثٍۭ بَعْدَهُۥ يُؤْمِنُونَ"}]}