{"ch":101,"verses":[{"v":1,"t":"부활의 날"},{"v":2,"t":"부활의 날이 무엇이뇨"},{"v":3,"t":"부활의 날이 무엇인지 무엇이그대에게 설명하리요"},{"v":4,"t":"그날은 인간이 나방처럼 흩어지는 날이며"},{"v":5,"t":"산들은 가지런한 양털처럼 되는 날로"},{"v":6,"t":"그날 그의 선행이 무거운 자 는"},{"v":7,"t":"안락한 삶을 영위할 것이나"},{"v":8,"t":"그의 선행이 가벼운 자는"},{"v":9,"t":"불지옥의 함정에 있게 되리라"},{"v":10,"t":"불지옥의 함정이 무엇인지 무엇이 그대에게 설명하려 주리요"},{"v":11,"t":"그것은 격렬하게 타오르는 불지옥이라"}]}