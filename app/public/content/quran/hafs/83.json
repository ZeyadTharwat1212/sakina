{"ch":83,"verses":[{"v":1,"t":"وَيۡلٞ لِّلۡمُطَفِّفِينَ","page":587,"l1":14,"l2":14},{"v":2,"t":"ٱلَّذِينَ إِذَا ٱكۡتَالُواْ عَلَى ٱلنَّاسِ يَسۡتَوۡفُونَ","page":587,"l1":14,"l2":14},{"v":3,"t":"وَإِذَا كَالُوهُمۡ أَو وَّزَنُوهُمۡ يُخۡسِرُونَ","page":587,"l1":15,"l2":15},{"v":4,"t":"أَلَا يَظُنُّ أُوْلَٰٓئِكَ أَنَّهُم مَّبۡعُوثُونَ","page":587,"l1":15,"l2":15},{"v":5,"t":"لِيَوۡمٍ عَظِيمٖ","page":588,"l1":1,"l2":1},{"v":6,"t":"يَوۡمَ يَقُومُ ٱلنَّاسُ لِرَبِّ ٱلۡعَٰلَمِينَ","page":588,"l1":1,"l2":1},{"v":7,"t":"كـَلَّآ إِنَّ كِتَٰبَ ٱلۡفُجَّارِ لَفِي سِجِّينٖ","page":588,"l1":1,"l2":2},{"v":8,"t":"وَمَآ أَدۡرَىٰكَ مَا سِجِّينٞ","page":588,"l1":2,"l2":2},{"v":9,"t":"كِتَٰبٞ مَّرۡقُومٞ","page":588,"l1":2,"l2":2},{"v":10,"t":"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ","page":588,"l1":3,"l2":3},{"v":11,"t":"ٱلَّذِينَ يُكَذِّبُونَ بِيَوۡمِ ٱلدِّينِ","page":588,"l1":3,"l2":3},{"v":12,"t":"وَمَا يُكَذِّبُ بِهِۦٓ إِلَّا كُلُّ مُعۡتَدٍ أَثِيمٍ","page":588,"l1":3,"l2":4},{"v":13,"t":"إِذَا تُتۡلَىٰ عَلَيۡهِ ءَايَٰتُنَا قَالَ أَسَٰطِيرُ ٱلۡأَوَّلِينَ","page":588,"l1":4,"l2":4},{"v":14,"t":"كـَلَّاۖ بَلۡۜ رَانَ عَلَىٰ قُلُوبِهِم مَّا كَانُواْ يَكۡسِبُونَ","page":588,"l1":5,"l2":5},{"v":15,"t":"كـَلَّآ إِنَّهُمۡ عَن رَّبِّهِمۡ يَوۡمَئِذٖ لَّمَحۡجُوبُونَ","page":588,"l1":5,"l2":6},{"v":16,"t":"ثُمَّ إِنَّهُمۡ لَصَالُواْ ٱلۡجَحِيمِ","page":588,"l1":6,"l2":6},{"v":17,"t":"ثُمَّ يُقَالُ هَٰذَا ٱلَّذِي كُنتُم بِهِۦ تُكَذِّبُونَ","page":588,"l1":6,"l2":7},{"v":18,"t":"كـَلَّآ إِنَّ كِتَٰبَ ٱلۡأَبۡرَارِ لَفِي عِلِّيِّينَ","page":588,"l1":7,"l2":7},{"v":19,"t":"وَمَآ أَدۡرَىٰكَ مَا عِلِّيُّونَ","page":588,"l1":8,"l2":8},{"v":20,"t":"كِتَٰبٞ مَّرۡقُومٞ","page":588,"l1":8,"l2":8},{"v":21,"t":"يَشۡهَدُهُ ٱلۡمُقَرَّبُونَ","page":588,"l1":8,"l2":8},{"v":22,"t":"إِنَّ ٱلۡأَبۡرَارَ لَفِي نَعِيمٍ","page":588,"l1":9,"l2":9},{"v":23,"t":"عَلَى ٱلۡأَرَآئِكِ يَنظُرُونَ","page":588,"l1":9,"l2":9},{"v":24,"t":"تَعۡرِفُ فِي وُجُوهِهِمۡ نَضۡرَةَ ٱلنَّعِيمِ","page":588,"l1":9,"l2":10},{"v":25,"t":"يُسۡقَوۡنَ مِن رَّحِيقٖ مَّخۡتُومٍ","page":588,"l1":10,"l2":10},{"v":26,"t":"خِتَٰمُهُۥ مِسۡكٞۚ وَفِي ذَٰلِكَ فَلۡيَتَنَافَسِ ٱلۡمُتَنَٰفِسُونَ","page":588,"l1":10,"l2":11},{"v":27,"t":"وَمِزَاجُهُۥ مِن تَسۡنِيمٍ","page":588,"l1":11,"l2":12},{"v":28,"t":"عَيۡنٗا يَشۡرَبُ بِهَا ٱلۡمُقَرَّبُونَ","page":588,"l1":12,"l2":12},{"v":29,"t":"إِنَّ ٱلَّذِينَ أَجۡرَمُواْ كَانُواْ مِنَ ٱلَّذِينَ ءَامَنُواْ يَضۡحَكُونَ","page":588,"l1":12,"l2":13},{"v":30,"t":"وَإِذَا مَرُّواْ بِهِمۡ يَتَغَامَزُونَ","page":588,"l1":13,"l2":13},{"v":31,"t":"وَإِذَا ٱنقَلَبُوٓاْ إِلَىٰٓ أَهۡلِهِمُ ٱنقَلَبُواْ فَكِهِينَ","page":588,"l1":14,"l2":14},{"v":32,"t":"وَإِذَا رَأَوۡهُمۡ قَالُوٓاْ إِنَّ هَٰٓؤُلَآءِ لَضَآلُّونَ","page":588,"l1":14,"l2":15},{"v":33,"t":"وَمَآ أُرۡسِلُواْ عَلَيۡهِمۡ حَٰفِظِينَ","page":588,"l1":15,"l2":15},{"v":34,"t":"فَٱلۡيَوۡمَ ٱلَّذِينَ ءَامَنُواْ مِنَ ٱلۡكُفَّارِ يَضۡحَكُونَ","page":589,"l1":1,"l2":1},{"v":35,"t":"عَلَى ٱلۡأَرَآئِكِ يَنظُرُونَ","page":589,"l1":1,"l2":2},{"v":36,"t":"هَلۡ ثُوِّبَ ٱلۡكُفَّارُ مَا كَانُواْ يَفۡعَلُونَ","page":589,"l1":2,"l2":2}]}