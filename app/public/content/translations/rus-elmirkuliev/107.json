{"ch":107,"verses":[{"v":1,"t":"Видел ли ты того, кто считает ложью воздаяние"},{"v":2,"t":"Это - тот, кто гонит сироту"},{"v":3,"t":"и не побуждает накормить бедняка"},{"v":4,"t":"Горе молящимся"},{"v":5,"t":"которые небрежны к своим намазам"},{"v":6,"t":"которые лицемерят"},{"v":7,"t":"и отказывают даже в мелочи"}]}