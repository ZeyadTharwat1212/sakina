{"ch":86,"basmalaPrefixLen":39,"verses":[{"v":1,"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلسَّمَآءِ وَٱلطَّارِقِ"},{"v":2,"t":"وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ"},{"v":3,"t":"ٱلنَّجْمُ ٱلثَّاقِبُ"},{"v":4,"t":"إِن كُلُّ نَفْسٍ لَّمَّا عَلَيْهَا حَافِظٌ"},{"v":5,"t":"فَلْيَنظُرِ ٱلْإِنسَٰنُ مِمَّ خُلِقَ"},{"v":6,"t":"خُلِقَ مِن مَّآءٍ دَافِقٍ"},{"v":7,"t":"يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ"},{"v":8,"t":"إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌ"},{"v":9,"t":"يَوْمَ تُبْلَى ٱلسَّرَآئِرُ"},{"v":10,"t":"فَمَا لَهُۥ مِن قُوَّةٍ وَلَا نَاصِرٍ"},{"v":11,"t":"وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ"},{"v":12,"t":"وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ"},{"v":13,"t":"إِنَّهُۥ لَقَوْلٌ فَصْلٌ"},{"v":14,"t":"وَمَا هُوَ بِٱلْهَزْلِ"},{"v":15,"t":"إِنَّهُمْ يَكِيدُونَ كَيْدًا"},{"v":16,"t":"وَأَكِيدُ كَيْدًا"},{"v":17,"t":"فَمَهِّلِ ٱلْكَٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا"}]}