{"ch":88,"verses":[{"v":1,"t":"大灾的消息，确已降临你了，"},{"v":2,"t":"在那日，将有许多人是恭敬的、"},{"v":3,"t":"劳动的、辛苦的，"},{"v":4,"t":"他们将入烈火，"},{"v":5,"t":"将饮沸泉，"},{"v":6,"t":"他们没有食物，但有荆棘，"},{"v":7,"t":"既不肥人，又不能充饥；"},{"v":8,"t":"在那日，将有许多人，是享福的，"},{"v":9,"t":"是为其劳绩而愉快的，"},{"v":10,"t":"他们将在崇高的乐园中，"},{"v":11,"t":"听不到恶言，"},{"v":12,"t":"里面有流泉，"},{"v":13,"t":"里面有高榻，"},{"v":14,"t":"有陈设着的杯盏，"},{"v":15,"t":"有排列着的靠枕，"},{"v":16,"t":"有铺展开的绒毯。"},{"v":17,"t":"难道他们不观察吗？骆驼是怎样造成的，"},{"v":18,"t":"天是怎样被升高的，"},{"v":19,"t":"山峦是怎样被竖立起的，"},{"v":20,"t":"大地是怎样被展开的。"},{"v":21,"t":"你当教诲，你只是教诲（他们的），"},{"v":22,"t":"你绝不是监察他们的，"},{"v":23,"t":"但谁转身离去而且不信教，"},{"v":24,"t":"安拉将以最大的刑罚惩治谁。"},{"v":25,"t":"他们必定只归于我，"},{"v":26,"t":"他们的稽核，必定由我负责。"}]}