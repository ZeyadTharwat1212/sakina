{"ch":104,"verses":[{"v":1,"t":"وَيۡلٞ لِّكُلِّ هُمَزَةٖ لُّمَزَةٍ","page":601,"l1":7,"l2":7},{"v":2,"t":"ٱلَّذِي جَمَعَ مَالٗا وَعَدَّدَهُۥ","page":601,"l1":7,"l2":7},{"v":3,"t":"يَحۡسَبُ أَنَّ مَالَهُۥٓ أَخۡلَدَهُۥ","page":601,"l1":8,"l2":8},{"v":4,"t":"كـَلَّاۖ لَيُنۢبَذَنَّ فِي ٱلۡحُطَمَةِ","page":601,"l1":8,"l2":8},{"v":5,"t":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡحُطَمَةُ","page":601,"l1":9,"l2":9},{"v":6,"t":"نَارُ ٱللَّهِ ٱلۡمُوقَدَةُ","page":601,"l1":9,"l2":9},{"v":7,"t":"ٱلَّتِي تَطَّلِعُ عَلَى ٱلۡأَفۡـِٔدَةِ","page":601,"l1":9,"l2":10},{"v":8,"t":"إِنَّهَا عَلَيۡهِم مُّؤۡصَدَةٞ","page":601,"l1":10,"l2":10},{"v":9,"t":"فِي عَمَدٖ مُّمَدَّدَةِۭ","page":601,"l1":10,"l2":10}]}