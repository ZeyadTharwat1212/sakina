{"ch":90,"basmalaPrefixLen":39,"verses":[{"v":1,"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ لَآ أُقْسِمُ بِهَٰذَا ٱلْبَلَدِ"},{"v":2,"t":"وَأَنتَ حِلٌّۢ بِهَٰذَا ٱلْبَلَدِ"},{"v":3,"t":"وَوَالِدٍ وَمَا وَلَدَ"},{"v":4,"t":"لَقَدْ خَلَقْنَا ٱلْإِنسَٰنَ فِى كَبَدٍ"},{"v":5,"t":"أَيَحْسَبُ أَن لَّن يَقْدِرَ عَلَيْهِ أَحَدٌ"},{"v":6,"t":"يَقُولُ أَهْلَكْتُ مَالًا لُّبَدًا"},{"v":7,"t":"أَيَحْسَبُ أَن لَّمْ يَرَهُۥٓ أَحَدٌ"},{"v":8,"t":"أَلَمْ نَجْعَل لَّهُۥ عَيْنَيْنِ"},{"v":9,"t":"وَلِسَانًا وَشَفَتَيْنِ"},{"v":10,"t":"وَهَدَيْنَٰهُ ٱلنَّجْدَيْنِ"},{"v":11,"t":"فَلَا ٱقْتَحَمَ ٱلْعَقَبَةَ"},{"v":12,"t":"وَمَآ أَدْرَىٰكَ مَا ٱلْعَقَبَةُ"},{"v":13,"t":"فَكُّ رَقَبَةٍ"},{"v":14,"t":"أَوْ إِطْعَٰمٌ فِى يَوْمٍ ذِى مَسْغَبَةٍ"},{"v":15,"t":"يَتِيمًا ذَا مَقْرَبَةٍ"},{"v":16,"t":"أَوْ مِسْكِينًا ذَا مَتْرَبَةٍ"},{"v":17,"t":"ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُوا۟ وَتَوَاصَوْا۟ بِٱلصَّبْرِ وَتَوَاصَوْا۟ بِٱلْمَرْحَمَةِ"},{"v":18,"t":"أُو۟لَٰٓئِكَ أَصْحَٰبُ ٱلْمَيْمَنَةِ"},{"v":19,"t":"وَٱلَّذِينَ كَفَرُوا۟ بِـَٔايَٰتِنَا هُمْ أَصْحَٰبُ ٱلْمَشْـَٔمَةِ"},{"v":20,"t":"عَلَيْهِمْ نَارٌ مُّؤْصَدَةٌۢ"}]}