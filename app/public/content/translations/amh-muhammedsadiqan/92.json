{"ch":92,"verses":[{"v":1,"t":"በሌሊቱ እምላለሁ (በጨለማው) በሚሸፍን ጊዜ፡፡"},{"v":2,"t":"በቀኑም፤ በተገለጸ ጊዜ፡፡"},{"v":3,"t":"ወንድንና ሴትን በፈጠረውም (አምላክ እምላለሁ)፡፡"},{"v":4,"t":"ሥራችሁ በእርግጥ የተለያየ ነው፡፡"},{"v":5,"t":"የሰጠ ሰውማ ጌታውን የፈራም፡፡"},{"v":6,"t":"በመልካሚቱም (እምነት) ያረጋገጠ፤"},{"v":7,"t":"ለገሪቱ ሥራ እናዘጋጀዋለን፡፡"},{"v":8,"t":"የሰሰተ ሰውማ የተብቃቃም፤ (በራሱ የተመካ)፤"},{"v":9,"t":"በመልካሚቱ (እምነት) ያሰተባበለም፤"},{"v":10,"t":"ለክፉይቱ ሥራ እናዘጋጀዋለን፡፡"},{"v":11,"t":"በወደቀም ጊዜ ገንዘቡ ከእርሱ ምንም አይጠቅመውም፡፡"},{"v":12,"t":"ቅኑን መንገድ መግለጽ በእኛ ላይ አለብን፡፡"},{"v":13,"t":"መጨረሻይቱም መጀመሪያይቱም ዓለም የእኛ ናቸው፡፡"},{"v":14,"t":"የምትንቀለቀልንም እሳት አስጠነቀቅኳችሁ (በላቸው)፡፡"},{"v":15,"t":"ከጠማማ በቀር ሌላ የማይገባት የኾነችን፡፡"},{"v":16,"t":"ያ ያስተባበለና ከትዕዛዝ የሸሸው፡፡"},{"v":17,"t":"አላህን በጣም ፈሪውም በእርግጥ ይርቃታል፡፡"},{"v":18,"t":"ያ የሚጥራራ ኾኖ ገንዘቡን (ለድኾች) የሚሰጠው፡፡"},{"v":19,"t":"ለአንድም ሰው እርሱ ዘንድ የምትመለስ ውለታ የለችም፡፡"},{"v":20,"t":"ግን የታላቅ ጌታውን ውዴታ ለመፈለግ (ይህንን ሠራ)፡፡"},{"v":21,"t":"ወደፊትም በእርግጥ ይደሰታል፡፡"}]}