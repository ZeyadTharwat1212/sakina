{"ch":92,"basmalaPrefixLen":39,"verses":[{"v":1,"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلَّيْلِ إِذَا يَغْشَىٰ"},{"v":2,"t":"وَٱلنَّهَارِ إِذَا تَجَلَّىٰ"},{"v":3,"t":"وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ"},{"v":4,"t":"إِنَّ سَعْيَكُمْ لَشَتَّىٰ"},{"v":5,"t":"فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ"},{"v":6,"t":"وَصَدَّقَ بِٱلْحُسْنَىٰ"},{"v":7,"t":"فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ"},{"v":8,"t":"وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ"},{"v":9,"t":"وَكَذَّبَ بِٱلْحُسْنَىٰ"},{"v":10,"t":"فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ"},{"v":11,"t":"وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ"},{"v":12,"t":"إِنَّ عَلَيْنَا لَلْهُدَىٰ"},{"v":13,"t":"وَإِنَّ لَنَا لَلْـَٔاخِرَةَ وَٱلْأُولَىٰ"},{"v":14,"t":"فَأَنذَرْتُكُمْ نَارًا تَلَظَّىٰ"},{"v":15,"t":"لَا يَصْلَىٰهَآ إِلَّا ٱلْأَشْقَى"},{"v":16,"t":"ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ"},{"v":17,"t":"وَسَيُجَنَّبُهَا ٱلْأَتْقَى"},{"v":18,"t":"ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ"},{"v":19,"t":"وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍ تُجْزَىٰٓ"},{"v":20,"t":"إِلَّا ٱبْتِغَآءَ وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ"},{"v":21,"t":"وَلَسَوْفَ يَرْضَىٰ"}]}