{"ch":92,"verses":[{"v":1,"t":"وَٱلَّيۡلِ إِذَا يَغۡشَىٰ","page":595,"l1":13,"l2":13},{"v":2,"t":"وَٱلنَّهَارِ إِذَا تَجَلَّىٰ","page":595,"l1":13,"l2":13},{"v":3,"t":"وَمَا خَلَقَ ٱلذَّكَرَ وَٱلۡأُنثَىٰٓ","page":595,"l1":13,"l2":13},{"v":4,"t":"إِنَّ سَعۡيَكُمۡ لَشَتَّىٰ","page":595,"l1":14,"l2":14},{"v":5,"t":"فَأَمَّا مَنۡ أَعۡطَىٰ وَٱتَّقَىٰ","page":595,"l1":14,"l2":14},{"v":6,"t":"وَصَدَّقَ بِٱلۡحُسۡنَىٰ","page":595,"l1":14,"l2":14},{"v":7,"t":"فَسَنُيَسِّرُهُۥ لِلۡيُسۡرَىٰ","page":595,"l1":15,"l2":15},{"v":8,"t":"وَأَمَّا مَنۢ بَخِلَ وَٱسۡتَغۡنَىٰ","page":595,"l1":15,"l2":15},{"v":9,"t":"وَكَذَّبَ بِٱلۡحُسۡنَىٰ","page":595,"l1":15,"l2":15},{"v":10,"t":"فَسَنُيَسِّرُهُۥ لِلۡعُسۡرَىٰ","page":596,"l1":1,"l2":1},{"v":11,"t":"وَمَا يُغۡنِي عَنۡهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ","page":596,"l1":1,"l2":1},{"v":12,"t":"إِنَّ عَلَيۡنَا لَلۡهُدَىٰ","page":596,"l1":1,"l2":2},{"v":13,"t":"وَإِنَّ لَنَا لَلۡأٓخِرَةَ وَٱلۡأُولَىٰ","page":596,"l1":2,"l2":2},{"v":14,"t":"فَأَنذَرۡتُكُمۡ نَارٗا تَلَظَّىٰ","page":596,"l1":2,"l2":2},{"v":15,"t":"لَا يَصۡلَىٰهَآ إِلَّا ٱلۡأَشۡقَى","page":596,"l1":3,"l2":3},{"v":16,"t":"ٱلَّذِي كَذَّبَ وَتَوَلَّىٰ","page":596,"l1":3,"l2":3},{"v":17,"t":"وَسَيُجَنَّبُهَا ٱلۡأَتۡقَى","page":596,"l1":3,"l2":4},{"v":18,"t":"ٱلَّذِي يُؤۡتِي مَالَهُۥ يَتَزَكَّىٰ","page":596,"l1":4,"l2":4},{"v":19,"t":"وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعۡمَةٖ تُجۡزَىٰٓ","page":596,"l1":4,"l2":5},{"v":20,"t":"إِلَّا ٱبۡتِغَآءَ وَجۡهِ رَبِّهِ ٱلۡأَعۡلَىٰ","page":596,"l1":5,"l2":5},{"v":21,"t":"وَلَسَوۡفَ يَرۡضَىٰ","page":596,"l1":5,"l2":5}]}