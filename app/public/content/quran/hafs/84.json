{"ch":84,"verses":[{"v":1,"t":"إِذَا ٱلسَّمَآءُ ٱنشَقَّتۡ","page":589,"l1":5,"l2":5},{"v":2,"t":"وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ","page":589,"l1":5,"l2":5},{"v":3,"t":"وَإِذَا ٱلۡأَرۡضُ مُدَّتۡ","page":589,"l1":5,"l2":5},{"v":4,"t":"وَأَلۡقَتۡ مَا فِيهَا وَتَخَلَّتۡ","page":589,"l1":6,"l2":6},{"v":5,"t":"وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ","page":589,"l1":6,"l2":6},{"v":6,"t":"يَٰٓأَيُّهَا ٱلۡإِنسَٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدۡحٗا فَمُلَٰقِيهِ","page":589,"l1":6,"l2":7},{"v":7,"t":"فَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ بِيَمِينِهِۦ","page":589,"l1":7,"l2":8},{"v":8,"t":"فَسَوۡفَ يُحَاسَبُ حِسَابٗا يَسِيرٗا","page":589,"l1":8,"l2":8},{"v":9,"t":"وَيَنقَلِبُ إِلَىٰٓ أَهۡلِهِۦ مَسۡرُورٗا","page":589,"l1":8,"l2":9},{"v":10,"t":"وَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ وَرَآءَ ظَهۡرِهِۦ","page":589,"l1":9,"l2":9},{"v":11,"t":"فَسَوۡفَ يَدۡعُواْ ثُبُورٗا","page":589,"l1":9,"l2":10},{"v":12,"t":"وَيَصۡلَىٰ سَعِيرًا","page":589,"l1":10,"l2":10},{"v":13,"t":"إِنَّهُۥ كَانَ فِيٓ أَهۡلِهِۦ مَسۡرُورًا","page":589,"l1":10,"l2":10},{"v":14,"t":"إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ","page":589,"l1":11,"l2":11},{"v":15,"t":"بَلَىٰٓۚ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرٗا","page":589,"l1":11,"l2":11},{"v":16,"t":"فَلَآ أُقۡسِمُ بِٱلشَّفَقِ","page":589,"l1":11,"l2":12},{"v":17,"t":"وَٱلَّيۡلِ وَمَا وَسَقَ","page":589,"l1":12,"l2":12},{"v":18,"t":"وَٱلۡقَمَرِ إِذَا ٱتَّسَقَ","page":589,"l1":12,"l2":12},{"v":19,"t":"لَتَرۡكَبُنَّ طَبَقًا عَن طَبَقٖ","page":589,"l1":13,"l2":13},{"v":20,"t":"فَمَا لَهُمۡ لَا يُؤۡمِنُونَ","page":589,"l1":13,"l2":13},{"v":21,"t":"وَإِذَا قُرِئَ عَلَيۡهِمُ ٱلۡقُرۡءَانُ لَا يَسۡجُدُونَۤ۩","page":589,"l1":13,"l2":14},{"v":22,"t":"بَلِ ٱلَّذِينَ كَفَرُواْ يُكَذِّبُونَ","page":589,"l1":14,"l2":14},{"v":23,"t":"وَٱللَّهُ أَعۡلَمُ بِمَا يُوعُونَ","page":589,"l1":15,"l2":15},{"v":24,"t":"فَبَشِّرۡهُم بِعَذَابٍ أَلِيمٍ","page":589,"l1":15,"l2":15},{"v":25,"t":"إِلَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ لَهُمۡ أَجۡرٌ غَيۡرُ مَمۡنُونِۭ","page":590,"l1":1,"l2":1}]}