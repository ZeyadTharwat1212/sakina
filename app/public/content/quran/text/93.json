{"ch":93,"basmalaPrefixLen":39,"verses":[{"v":1,"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلضُّحَىٰ"},{"v":2,"t":"وَٱلَّيْلِ إِذَا سَجَىٰ"},{"v":3,"t":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ"},{"v":4,"t":"وَلَلْـَٔاخِرَةُ خَيْرٌ لَّكَ مِنَ ٱلْأُولَىٰ"},{"v":5,"t":"وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ"},{"v":6,"t":"أَلَمْ يَجِدْكَ يَتِيمًا فَـَٔاوَىٰ"},{"v":7,"t":"وَوَجَدَكَ ضَآلًّا فَهَدَىٰ"},{"v":8,"t":"وَوَجَدَكَ عَآئِلًا فَأَغْنَىٰ"},{"v":9,"t":"فَأَمَّا ٱلْيَتِيمَ فَلَا تَقْهَرْ"},{"v":10,"t":"وَأَمَّا ٱلسَّآئِلَ فَلَا تَنْهَرْ"},{"v":11,"t":"وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ"}]}