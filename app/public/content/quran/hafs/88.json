{"ch":88,"verses":[{"v":1,"t":"هَلۡ أَتَىٰكَ حَدِيثُ ٱلۡغَٰشِيَةِ","page":592,"l1":7,"l2":7},{"v":2,"t":"وُجُوهٞ يَوۡمَئِذٍ خَٰشِعَةٌ","page":592,"l1":7,"l2":7},{"v":3,"t":"عَامِلَةٞ نَّاصِبَةٞ","page":592,"l1":7,"l2":8},{"v":4,"t":"تَصۡلَىٰ نَارًا حَامِيَةٗ","page":592,"l1":8,"l2":8},{"v":5,"t":"تُسۡقَىٰ مِنۡ عَيۡنٍ ءَانِيَةٖ","page":592,"l1":8,"l2":8},{"v":6,"t":"لَّيۡسَ لَهُمۡ طَعَامٌ إِلَّا مِن ضَرِيعٖ","page":592,"l1":8,"l2":9},{"v":7,"t":"لَّا يُسۡمِنُ وَلَا يُغۡنِي مِن جُوعٖ","page":592,"l1":9,"l2":9},{"v":8,"t":"وُجُوهٞ يَوۡمَئِذٖ نَّاعِمَةٞ","page":592,"l1":9,"l2":10},{"v":9,"t":"لِّسَعۡيِهَا رَاضِيَةٞ","page":592,"l1":10,"l2":10},{"v":10,"t":"فِي جَنَّةٍ عَالِيَةٖ","page":592,"l1":10,"l2":10},{"v":11,"t":"لَّا تَسۡمَعُ فِيهَا لَٰغِيَةٗ","page":592,"l1":10,"l2":11},{"v":12,"t":"فِيهَا عَيۡنٞ جَارِيَةٞ","page":592,"l1":11,"l2":11},{"v":13,"t":"فِيهَا سُرُرٞ مَّرۡفُوعَةٞ","page":592,"l1":11,"l2":11},{"v":14,"t":"وَأَكۡوَابٞ مَّوۡضُوعَةٞ","page":592,"l1":11,"l2":12},{"v":15,"t":"وَنَمَارِقُ مَصۡفُوفَةٞ","page":592,"l1":12,"l2":12},{"v":16,"t":"وَزَرَابِيُّ مَبۡثُوثَةٌ","page":592,"l1":12,"l2":12},{"v":17,"t":"أَفَلَا يَنظُرُونَ إِلَى ٱلۡإِبِلِ كَيۡفَ خُلِقَتۡ","page":592,"l1":12,"l2":13},{"v":18,"t":"وَإِلَى ٱلسَّمَآءِ كَيۡفَ رُفِعَتۡ","page":592,"l1":13,"l2":13},{"v":19,"t":"وَإِلَى ٱلۡجِبَالِ كَيۡفَ نُصِبَتۡ","page":592,"l1":13,"l2":14},{"v":20,"t":"وَإِلَى ٱلۡأَرۡضِ كَيۡفَ سُطِحَتۡ","page":592,"l1":14,"l2":14},{"v":21,"t":"فَذَكِّرۡ إِنَّمَآ أَنتَ مُذَكِّرٞ","page":592,"l1":15,"l2":15},{"v":22,"t":"لَّسۡتَ عَلَيۡهِم بِمُصَيۡطِرٍ","page":592,"l1":15,"l2":15},{"v":23,"t":"إِلَّا مَن تَوَلَّىٰ وَكَفَرَ","page":593,"l1":1,"l2":1},{"v":24,"t":"فَيُعَذِّبُهُ ٱللَّهُ ٱلۡعَذَابَ ٱلۡأَكۡبَرَ","page":593,"l1":1,"l2":1},{"v":25,"t":"إِنَّ إِلَيۡنَآ إِيَابَهُمۡ","page":593,"l1":2,"l2":2},{"v":26,"t":"ثُمَّ إِنَّ عَلَيۡنَا حِسَابَهُم","page":593,"l1":2,"l2":2}]}