{"ch":90,"verses":[{"v":1,"t":"لَآ أُقۡسِمُ بِهَٰذَا ٱلۡبَلَدِ","page":594,"l1":8,"l2":8},{"v":2,"t":"وَأَنتَ حِلُّۢ بِهَٰذَا ٱلۡبَلَدِ","page":594,"l1":8,"l2":8},{"v":3,"t":"وَوَالِدٖ وَمَا وَلَدَ","page":594,"l1":8,"l2":8},{"v":4,"t":"لَقَدۡ خَلَقۡنَا ٱلۡإِنسَٰنَ فِي كَبَدٍ","page":594,"l1":9,"l2":9},{"v":5,"t":"أَيَحۡسَبُ أَن لَّن يَقۡدِرَ عَلَيۡهِ أَحَدٞ","page":594,"l1":9,"l2":10},{"v":6,"t":"يَقُولُ أَهۡلَكۡتُ مَالٗا لُّبَدًا","page":594,"l1":10,"l2":10},{"v":7,"t":"أَيَحۡسَبُ أَن لَّمۡ يَرَهُۥٓ أَحَدٌ","page":594,"l1":10,"l2":10},{"v":8,"t":"أَلَمۡ نَجۡعَل لَّهُۥ عَيۡنَيۡنِ","page":594,"l1":11,"l2":11},{"v":9,"t":"وَلِسَانٗا وَشَفَتَيۡنِ","page":594,"l1":11,"l2":11},{"v":10,"t":"وَهَدَيۡنَٰهُ ٱلنَّجۡدَيۡنِ","page":594,"l1":11,"l2":12},{"v":11,"t":"فَلَا ٱقۡتَحَمَ ٱلۡعَقَبَةَ","page":594,"l1":12,"l2":12},{"v":12,"t":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡعَقَبَةُ","page":594,"l1":12,"l2":12},{"v":13,"t":"فَكُّ رَقَبَةٍ","page":594,"l1":13,"l2":13},{"v":14,"t":"أَوۡ إِطۡعَٰمٞ فِي يَوۡمٖ ذِي مَسۡغَبَةٖ","page":594,"l1":13,"l2":13},{"v":15,"t":"يَتِيمٗا ذَا مَقۡرَبَةٍ","page":594,"l1":13,"l2":13},{"v":16,"t":"أَوۡ مِسۡكِينٗا ذَا مَتۡرَبَةٖ","page":594,"l1":14,"l2":14},{"v":17,"t":"ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُواْ وَتَوَاصَوۡاْ بِٱلصَّبۡرِ وَتَوَاصَوۡاْ بِٱلۡمَرۡحَمَةِ","page":594,"l1":14,"l2":15},{"v":18,"t":"أُوْلَٰٓئِكَ أَصۡحَٰبُ ٱلۡمَيۡمَنَةِ","page":594,"l1":15,"l2":15},{"v":19,"t":"وَٱلَّذِينَ كَفَرُواْ بِـَٔايَٰتِنَا هُمۡ أَصۡحَٰبُ ٱلۡمَشۡـَٔمَةِ","page":595,"l1":1,"l2":1},{"v":20,"t":"عَلَيۡهِمۡ نَارٞ مُّؤۡصَدَةُۢ","page":595,"l1":1,"l2":1}]}