{"ch":100,"verses":[{"v":1,"t":"وَٱلۡعَٰدِيَٰتِ ضَبۡحٗا","page":599,"l1":14,"l2":14},{"v":2,"t":"فَٱلۡمُورِيَٰتِ قَدۡحٗا","page":599,"l1":14,"l2":14},{"v":3,"t":"فَٱلۡمُغِيرَٰتِ صُبۡحٗا","page":599,"l1":14,"l2":15},{"v":4,"t":"فَأَثَرۡنَ بِهِۦ نَقۡعٗا","page":599,"l1":15,"l2":15},{"v":5,"t":"فَوَسَطۡنَ بِهِۦ جَمۡعًا","page":599,"l1":15,"l2":15},{"v":6,"t":"إِنَّ ٱلۡإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٞ","page":600,"l1":1,"l2":1},{"v":7,"t":"وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٞ","page":600,"l1":1,"l2":1},{"v":8,"t":"وَإِنَّهُۥ لِحُبِّ ٱلۡخَيۡرِ لَشَدِيدٌ","page":600,"l1":1,"l2":2},{"v":9,"t":"۞ أَفَلَا يَعۡلَمُ إِذَا بُعۡثِرَ مَا فِي ٱلۡقُبُورِ","page":600,"l1":2,"l2":2},{"v":10,"t":"وَحُصِّلَ مَا فِي ٱلصُّدُورِ","page":600,"l1":3,"l2":3},{"v":11,"t":"إِنَّ رَبَّهُم بِهِمۡ يَوۡمَئِذٖ لَّخَبِيرُۢ","page":600,"l1":3,"l2":3}]}