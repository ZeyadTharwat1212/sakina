{"ch":96,"basmalaPrefixLen":39,"verses":[{"v":1,"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ"},{"v":2,"t":"خَلَقَ ٱلْإِنسَٰنَ مِنْ عَلَقٍ"},{"v":3,"t":"ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ"},{"v":4,"t":"ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ"},{"v":5,"t":"عَلَّمَ ٱلْإِنسَٰنَ مَا لَمْ يَعْلَمْ"},{"v":6,"t":"كَلَّآ إِنَّ ٱلْإِنسَٰنَ لَيَطْغَىٰٓ"},{"v":7,"t":"أَن رَّءَاهُ ٱسْتَغْنَىٰٓ"},{"v":8,"t":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ"},{"v":9,"t":"أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ"},{"v":10,"t":"عَبْدًا إِذَا صَلَّىٰٓ"},{"v":11,"t":"أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ"},{"v":12,"t":"أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ"},{"v":13,"t":"أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ"},{"v":14,"t":"أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ"},{"v":15,"t":"كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ"},{"v":16,"t":"نَاصِيَةٍ كَٰذِبَةٍ خَاطِئَةٍ"},{"v":17,"t":"فَلْيَدْعُ نَادِيَهُۥ"},{"v":18,"t":"سَنَدْعُ ٱلزَّبَانِيَةَ"},{"v":19,"t":"كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب"}]}