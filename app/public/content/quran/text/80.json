{"ch":80,"basmalaPrefixLen":39,"verses":[{"v":1,"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ عَبَسَ وَتَوَلَّىٰٓ"},{"v":2,"t":"أَن جَآءَهُ ٱلْأَعْمَىٰ"},{"v":3,"t":"وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ"},{"v":4,"t":"أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ"},{"v":5,"t":"أَمَّا مَنِ ٱسْتَغْنَىٰ"},{"v":6,"t":"فَأَنتَ لَهُۥ تَصَدَّىٰ"},{"v":7,"t":"وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ"},{"v":8,"t":"وَأَمَّا مَن جَآءَكَ يَسْعَىٰ"},{"v":9,"t":"وَهُوَ يَخْشَىٰ"},{"v":10,"t":"فَأَنتَ عَنْهُ تَلَهَّىٰ"},{"v":11,"t":"كَلَّآ إِنَّهَا تَذْكِرَةٌ"},{"v":12,"t":"فَمَن شَآءَ ذَكَرَهُۥ"},{"v":13,"t":"فِى صُحُفٍ مُّكَرَّمَةٍ"},{"v":14,"t":"مَّرْفُوعَةٍ مُّطَهَّرَةٍۭ"},{"v":15,"t":"بِأَيْدِى سَفَرَةٍ"},{"v":16,"t":"كِرَامٍۭ بَرَرَةٍ"},{"v":17,"t":"قُتِلَ ٱلْإِنسَٰنُ مَآ أَكْفَرَهُۥ"},{"v":18,"t":"مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ"},{"v":19,"t":"مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ"},{"v":20,"t":"ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ"},{"v":21,"t":"ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ"},{"v":22,"t":"ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ"},{"v":23,"t":"كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ"},{"v":24,"t":"فَلْيَنظُرِ ٱلْإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ"},{"v":25,"t":"أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّا"},{"v":26,"t":"ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّا"},{"v":27,"t":"فَأَنۢبَتْنَا فِيهَا حَبًّا"},{"v":28,"t":"وَعِنَبًا وَقَضْبًا"},{"v":29,"t":"وَزَيْتُونًا وَنَخْلًا"},{"v":30,"t":"وَحَدَآئِقَ غُلْبًا"},{"v":31,"t":"وَفَٰكِهَةً وَأَبًّا"},{"v":32,"t":"مَّتَٰعًا لَّكُمْ وَلِأَنْعَٰمِكُمْ"},{"v":33,"t":"فَإِذَا جَآءَتِ ٱلصَّآخَّةُ"},{"v":34,"t":"يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ"},{"v":35,"t":"وَأُمِّهِۦ وَأَبِيهِ"},{"v":36,"t":"وَصَٰحِبَتِهِۦ وَبَنِيهِ"},{"v":37,"t":"لِكُلِّ ٱمْرِئٍ مِّنْهُمْ يَوْمَئِذٍ شَأْنٌ يُغْنِيهِ"},{"v":38,"t":"وُجُوهٌ يَوْمَئِذٍ مُّسْفِرَةٌ"},{"v":39,"t":"ضَاحِكَةٌ مُّسْتَبْشِرَةٌ"},{"v":40,"t":"وَوُجُوهٌ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌ"},{"v":41,"t":"تَرْهَقُهَا قَتَرَةٌ"},{"v":42,"t":"أُو۟لَٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ"}]}