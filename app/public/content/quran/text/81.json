{"ch":81,"basmalaPrefixLen":39,"verses":[{"v":1,"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلشَّمْسُ كُوِّرَتْ"},{"v":2,"t":"وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ"},{"v":3,"t":"وَإِذَا ٱلْجِبَالُ سُيِّرَتْ"},{"v":4,"t":"وَإِذَا ٱلْعِشَارُ عُطِّلَتْ"},{"v":5,"t":"وَإِذَا ٱلْوُحُوشُ حُشِرَتْ"},{"v":6,"t":"وَإِذَا ٱلْبِحَارُ سُجِّرَتْ"},{"v":7,"t":"وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ"},{"v":8,"t":"وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ"},{"v":9,"t":"بِأَىِّ ذَنۢبٍ قُتِلَتْ"},{"v":10,"t":"وَإِذَا ٱلصُّحُفُ نُشِرَتْ"},{"v":11,"t":"وَإِذَا ٱلسَّمَآءُ كُشِطَتْ"},{"v":12,"t":"وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ"},{"v":13,"t":"وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ"},{"v":14,"t":"عَلِمَتْ نَفْسٌ مَّآ أَحْضَرَتْ"},{"v":15,"t":"فَلَآ أُقْسِمُ بِٱلْخُنَّسِ"},{"v":16,"t":"ٱلْجَوَارِ ٱلْكُنَّسِ"},{"v":17,"t":"وَٱلَّيْلِ إِذَا عَسْعَسَ"},{"v":18,"t":"وَٱلصُّبْحِ إِذَا تَنَفَّسَ"},{"v":19,"t":"إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ"},{"v":20,"t":"ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍ"},{"v":21,"t":"مُّطَاعٍ ثَمَّ أَمِينٍ"},{"v":22,"t":"وَمَا صَاحِبُكُم بِمَجْنُونٍ"},{"v":23,"t":"وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ"},{"v":24,"t":"وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍ"},{"v":25,"t":"وَمَا هُوَ بِقَوْلِ شَيْطَٰنٍ رَّجِيمٍ"},{"v":26,"t":"فَأَيْنَ تَذْهَبُونَ"},{"v":27,"t":"إِنْ هُوَ إِلَّا ذِكْرٌ لِّلْعَٰلَمِينَ"},{"v":28,"t":"لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ"},{"v":29,"t":"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَٰلَمِينَ"}]}