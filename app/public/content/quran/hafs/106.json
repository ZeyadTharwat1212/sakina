{"ch":106,"verses":[{"v":1,"t":"لِإِيلَٰفِ قُرَيۡشٍ","page":602,"l1":3,"l2":3},{"v":2,"t":"إِۦلَٰفِهِمۡ رِحۡلَةَ ٱلشِّتَآءِ وَٱلصَّيۡفِ","page":602,"l1":3,"l2":3},{"v":3,"t":"فَلۡيَعۡبُدُواْ رَبَّ هَٰذَا ٱلۡبَيۡتِ","page":602,"l1":4,"l2":4},{"v":4,"t":"ٱلَّذِيٓ أَطۡعَمَهُم مِّن جُوعٖ وَءَامَنَهُم مِّنۡ خَوۡفِۭ","page":602,"l1":4,"l2":5}]}