{"ch":81,"verses":[{"v":1,"t":"当太阳黯黜的时候，"},{"v":2,"t":"当星宿零落的时候，"},{"v":3,"t":"当山峦崩溃的时候，"},{"v":4,"t":"当孕驼被抛弃的时候，"},{"v":5,"t":"当野兽被集合的时候，"},{"v":6,"t":"当海洋澎湃的时候，"},{"v":7,"t":"当灵魂被配合的时候，"},{"v":8,"t":"当被活埋的女孩被询问的时候："},{"v":9,"t":"她为什么罪过而遭杀害呢？"},{"v":10,"t":"当功过薄被展开的时候，"},{"v":11,"t":"当天皮被揭去的时候，"},{"v":12,"t":"当火狱被燃着的时候，"},{"v":13,"t":"当乐园被送近的时候，"},{"v":14,"t":"每个人都知道他所作过的善恶。"},{"v":15,"t":"我誓以运行的众星"},{"v":16,"t":"没落的行星，"},{"v":17,"t":"和逝去时的黑夜，"},{"v":18,"t":"照耀时的早晨，"},{"v":19,"t":"这确是一个尊贵的使者的言辞，"},{"v":20,"t":"他在宝座的主那里，是有权力的，是有地位的，"},{"v":21,"t":"是众望所归，而且忠於职守的。"},{"v":22,"t":"你们的朋友，不是一个疯人，"},{"v":23,"t":"他确已看见那个天使在明显的天边，"},{"v":24,"t":"他对幽玄不是吝教的。"},{"v":25,"t":"这不是被放逐的恶魔的言辞，"},{"v":26,"t":"你们将往哪里去呢？"},{"v":27,"t":"这只是对于众世界的教诲——"},{"v":28,"t":"对於你们中欲循规蹈矩者的教诲，"},{"v":29,"t":"你们不欲循规蹈矩，除非安拉——众世界的主——意欲的时候。"}]}