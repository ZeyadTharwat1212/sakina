{"ch":87,"basmalaPrefixLen":39,"verses":[{"v":1,"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى"},{"v":2,"t":"ٱلَّذِى خَلَقَ فَسَوَّىٰ"},{"v":3,"t":"وَٱلَّذِى قَدَّرَ فَهَدَىٰ"},{"v":4,"t":"وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ"},{"v":5,"t":"فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ"},{"v":6,"t":"سَنُقْرِئُكَ فَلَا تَنسَىٰٓ"},{"v":7,"t":"إِلَّا مَا شَآءَ ٱللَّهُ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ"},{"v":8,"t":"وَنُيَسِّرُكَ لِلْيُسْرَىٰ"},{"v":9,"t":"فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ"},{"v":10,"t":"سَيَذَّكَّرُ مَن يَخْشَىٰ"},{"v":11,"t":"وَيَتَجَنَّبُهَا ٱلْأَشْقَى"},{"v":12,"t":"ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ"},{"v":13,"t":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ"},{"v":14,"t":"قَدْ أَفْلَحَ مَن تَزَكَّىٰ"},{"v":15,"t":"وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ"},{"v":16,"t":"بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا"},{"v":17,"t":"وَٱلْـَٔاخِرَةُ خَيْرٌ وَأَبْقَىٰٓ"},{"v":18,"t":"إِنَّ هَٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ"},{"v":19,"t":"صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ"}]}