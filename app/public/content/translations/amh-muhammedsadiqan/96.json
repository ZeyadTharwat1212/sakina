{"ch":96,"verses":[{"v":1,"t":"አንብብ በዚያ (ሁሉን) በፈጠረው ጌታህ ስም፡፡"},{"v":2,"t":"ሰውን ከረጋ ደም በፈጠረው (ጌታህ ስም)፡፡"},{"v":3,"t":"አንብብ፤ ጌታህ በጣም ቸር ሲኾን፤"},{"v":4,"t":"ያ በብርዕ ያስተማረ፡፡"},{"v":5,"t":"ሰውን ያላወቀውን ሁሉ ያሳወቀ ሲኾን፡፡"},{"v":6,"t":"በእውነቱ ሰው ወሰንን ያልፋል፡፡"},{"v":7,"t":"ራሱን የተብቃቃ (ባለ ሀብት) ኾኖ ለማየቱ፡፡"},{"v":8,"t":"መመለሻው ወደ ጌታህ ብቻ ነው፡፡"},{"v":9,"t":"አየህን? ያንን የሚከለክለውን፡፡"},{"v":10,"t":"ባሪያን በሰገደ ጊዜ፤"},{"v":11,"t":"አየህን? ንገረኝ (ተከልካዩ) በትክክለኛ መንገድ ላይ ቢኾን፤"},{"v":12,"t":"ወይም (ፈጣሪውን) በመፍራት ቢያዝ፤"},{"v":13,"t":"አየህን? ንገረኝ (ከልካዩ) ቢያስተባብልና (ከእምነት) ቢሸሽ፤"},{"v":14,"t":"አላህ የሚያይ መኾኑን አያውቅምን"},{"v":15,"t":"ይተው ባይከለከል አናቱን ይዘን እንጎትተዋለን፡፡"},{"v":16,"t":"ውሸታም ስሕተተኛ የኾነችውን አናቱን፡፡"},{"v":17,"t":"ሸንጎውንም ይጥራ፡፡"},{"v":18,"t":"(እኛም) ዘበኞቻችንን እንጠራለን፡፡"},{"v":19,"t":"ይከልከል አትታዘዘው፡፡ ስገድም፤ (ወደ አላህ) ተቃረብም፡፡"}]}